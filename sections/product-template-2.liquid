<script>
(function () {
  var sectionId = {{ section.id | json }};

  function initButtonPrice() {
    var priceElement = document.getElementById('ProductPrice-' + sectionId);
    var button = document.getElementById('AddToCart-' + sectionId);

    if (!priceElement || !button) return;

    var buttonPrice = button.querySelector('[data-atc-price]');
    if (!buttonPrice) return;

    function updatePrice() {
      var price = priceElement.textContent.trim();
      if (price) buttonPrice.textContent = price;
    }

    updatePrice();

    if (buttonPrice._priceObserver) {
      buttonPrice._priceObserver.disconnect();
    }

    var observer = new MutationObserver(updatePrice);

    observer.observe(priceElement, {
      childList: true,
      subtree: true,
      characterData: true
    });

    buttonPrice._priceObserver = observer;
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initButtonPrice);
  } else {
    initButtonPrice();
  }
})();
</script>

{% comment %} Shipping notice: Liquid's 'now' is frozen in Shopify's page cache, so set the date in the browser {% endcomment %}
<script>
(function () {
  var MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

  function ordinal(day) {
    if (day % 100 >= 11 && day % 100 <= 13) return 'th';
    return { 1: 'st', 2: 'nd', 3: 'rd' }[day % 10] || 'th';
  }

  function updateShippingDeadlines() {
    document.querySelectorAll('[data-shipping-deadline]').forEach(function (el) {
      var date = new Date();
      date.setDate(date.getDate() + (parseInt(el.dataset.days, 10) || 0));
      var day = date.getDate();
      el.textContent = MONTHS[date.getMonth()] + ' ' + day + ordinal(day);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', updateShippingDeadlines);
  } else {
    updateShippingDeadlines();
  }

  document.addEventListener('shopify:section:load', updateShippingDeadlines);
})();
</script>

{% comment %} update prices according to the appstle bundles and subscriptions {% endcomment %}
<script>

(function () {
  function initDynamicProductPrice() {
    const cards = document.querySelectorAll(
      '.custom-product-price[id^="CustomProductPrice-"]'
    );

    cards.forEach(function (card) {
      if (card.dataset.dynamicPriceReady === 'true') return;
      card.dataset.dynamicPriceReady = 'true';

      const currentEl = card.querySelector('[data-current-price]');
      const originalEl = card.querySelector('[data-original-price]');
      const savingsEl = card.querySelector('[data-savings-amount]');
      const headingEl = card.querySelector('[data-price-savings-heading]');

      if (!currentEl || !originalEl || !savingsEl || !headingEl) return;

      const currencyFormat = new Intl.NumberFormat('en-PK', {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
      });

      function parsePrice(text) {
        if (!text) return null;

        const cleaned = text.replace(/,/g, '').match(/-?\d+(?:\.\d+)?/);
        return cleaned ? Number(cleaned[0]) : null;
      }

      function formatPrice(amount, referenceText) {
        const currencyMatch = (referenceText || '').match(/^[\s]*([^\d\s]+)\s*/);
        const currency = currencyMatch ? currencyMatch[1] : 'Rs.';
        return currency + currencyFormat.format(amount);
      }

      function getSelectedBundle() {
        const selected = document.querySelector(
          '.ab-volume-discount-item-selected-v2'
        );

        if (!selected) return null;

        const title = selected.querySelector(
          '.ab-volume-discount-item-title-label-v2'
        );

        const priceEl = selected.querySelector('.volume-discount-price-v2');
        const originalPriceEl = selected.querySelector(
          '.volume-original-price-v2'
        );

        const quantityMatch = title
          ? title.textContent.match(/Buy\s+(\d+)/i)
          : null;

        return {
          quantity: quantityMatch ? Number(quantityMatch[1]) : 1,
          unitPrice: priceEl ? parsePrice(priceEl.textContent) : null,
          unitOriginal: originalPriceEl
            ? parsePrice(originalPriceEl.textContent)
            : null
        };
      }

      function getSelectedSubscriptionPrice() {
        const checked = document.querySelector(
          '.appstle_subscription_wrapper input[name="selling_plan"]:checked'
        );

        if (!checked) return null;

        const option = checked.closest('.appstle_subscription_wrapper_option');
        if (!option) return null;

        const priceEl = option.querySelector(
          '.appstle_subscription_amount[aria-hidden="true"]'
        );

        return priceEl ? parsePrice(priceEl.textContent) : null;
      }

      function updatePrice() {
        const bundle = getSelectedBundle();

        const subscriptionPrice = getSelectedSubscriptionPrice();

        let currentPrice = null;
        let originalPrice = null;

        // Appstle subscription price is the total for the selected option.
        if (subscriptionPrice !== null) {
          currentPrice = subscriptionPrice;
        }

        // Bundle prices are shown per item, so multiply by the chosen quantity.
        if (bundle) {
          if (currentPrice === null && bundle.unitPrice !== null) {
            currentPrice = bundle.unitPrice * bundle.quantity;
          }

          if (bundle.unitOriginal !== null) {
            originalPrice = bundle.unitOriginal * bundle.quantity;
          } else if (bundle.unitPrice !== null) {
            // Non-discounted bundle: its own price is the original price,
            // not the variant's compare-at price.
            originalPrice = bundle.unitPrice * bundle.quantity;
          }
        }

        const isNonDiscountedBundle = Boolean(bundle && bundle.unitOriginal === null);

        // Use Shopify's current displayed price as a fallback.
        if (currentPrice === null) {
          currentPrice = parsePrice(currentEl.textContent);
        }

        if (originalPrice === null) {
          originalPrice = parsePrice(originalEl.textContent);
        }

        if (currentPrice === null || originalPrice === null) return;

        // Do not display a negative saving.
        const savings = Math.max(0, originalPrice - currentPrice);
        const savingsPercent = originalPrice > 0
          ? Math.round((savings / originalPrice) * 100)
          : 0;

        const currencyReference =
          (bundle &&
            document.querySelector(
              '.ab-volume-discount-item-selected-v2 .volume-discount-price-v2'
            )?.textContent) ||
          currentEl.textContent;

        currentEl.textContent = formatPrice(currentPrice, currencyReference);
        currentEl.setAttribute('content', (currentPrice).toFixed(2));

        // Non-discounted bundle with no saving: show the plain price (no strike-through)
        // and $0.00 savings. data-no-discount also tells the sticky cart to skip them.
        const noDiscount = isNonDiscountedBundle && savings <= 0;

        originalEl.textContent = formatPrice(originalPrice, currencyReference);
        savingsEl.textContent = formatPrice(noDiscount ? 0 : savings, currencyReference);
        originalEl.toggleAttribute('data-no-discount', noDiscount);

        // A heading set in the block settings stays as written.
        if (!headingEl.hasAttribute('data-fixed-heading')) {
          headingEl.textContent = 'Save up to ' + 55 + '% off today';
        }

        // Hide the strike-through original price if there is no discount.
        originalEl.style.display = savings > 0 || noDiscount ? '' : 'none';
      }

      let updateTimer;

      function scheduleUpdate() {
        window.clearTimeout(updateTimer);
        updateTimer = window.setTimeout(updatePrice, 150);
      }

      // Listen for bundle selection, subscription selection and delivery frequency.
      document.addEventListener('click', scheduleUpdate);
      document.addEventListener('change', scheduleUpdate);

      // Appstle changes its prices dynamically; watch for those updates too.
      const observer = new MutationObserver(scheduleUpdate);

      observer.observe(document.body, {
        subtree: true,
        childList: true,
        characterData: true,
        attributes: true,
        attributeFilter: ['class', 'checked', 'aria-checked']
      });

      scheduleUpdate();
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initDynamicProductPrice);
  } else {
    initDynamicProductPrice();
  }

  // Support Shopify theme editor section reloads.
  document.addEventListener('shopify:section:load', initDynamicProductPrice);
})();
</script>
