                              <span class="custom-atc-separator" aria-hidden="true">·</span>
                              <span
                                class="custom-atc-price"
                                data-atc-price
                                {% unless current_variant.available %}hidden{% endunless %}
                              >
                                {{ current_variant.price | money }}
                              </span>
