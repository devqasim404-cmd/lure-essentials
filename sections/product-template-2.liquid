                                    <use xlink:href="#image0_29736_593" transform="matrix(0.00133929 0 0 0.00195312 0.157143 0)"/>
                                    </pattern>
                                    <image id="image0_29736_593" width="512" height="512" preserveAspectRatio="none" xlink:href="data:image/png;base64,"/>
