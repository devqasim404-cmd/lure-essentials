                                      <a href="{{ settings.terms_link }}" class="link">
                                        {{- settings.terms_and_condition -}}
                                      </a>
                                    </label>
                                  </div>
                                </div>
                                <div class="product-form__buynow w-100 disabled">
                                  {{ form | payment_button }}
                                  {% if current_variant.available == false %}
                                    <style>
                                      .shopify-payment-button{display:none}
                                    </style>
                                  {% endif %}
                                </div>
                              </div>
                            </buy-now>
                          {%- else -%}
                            <div class="product-form__buynow w-100 ">
                              {{ form | payment_button }}
                              {% if current_variant.available == false %}
                                <style>
                                  .shopify-payment-button{display:none}
                                </style>
                              {% endif %}
                            </div>
                          {%- endif -%}
                        {% endif %}
