<!-- product-template-1.liquid -->
  <link
  rel="stylesheet"
  href="{{ 'photoswipe.css' | asset_url }}"
>

<script src="{{ 'photoswipe.min.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'photoswipe-ui-default.min.js' | asset_url }}" defer="defer"></script>
{%- assign first_3d_model = product.media | where: 'media_type', 'model' | first -%}
<link
  rel="stylesheet"
  href="{{ 'component-deferred-media.css' | asset_url }}"
>
  <link
  rel="stylesheet"
  href="{{ 'component-product-model.css' | asset_url }}"
>

{%- if first_3d_model -%}
  <link
    id="ModelViewerStyle"
    rel="stylesheet"
    href="https://cdn.shopify.com/shopifycloud/model-viewer-ui/assets/v1.0/model-viewer-ui.css"
    media="print"
    onload="this.media='all'"
  >
  <link
    id="ModelViewerOverride"
    rel="stylesheet"
    href="{{ 'component-model-viewer-ui.css' | asset_url }}"
    media="print"
    onload="this.media='all'"
  >
{%- endif -%}
<link
  rel="stylesheet"
  href="{{ 'product-template.css' | asset_url }}"
>

<div
  class="{{ section.settings.setwidth }} js-recently-view main_product_template"
  itemscope
  itemtype="http://schema.org/Product"
  id="ProductSection-{{ section.id }}"
  data-id="{{ section.settings.media_style }}"
  data-section-id="{{ section.id }}"
  data-section-type="product"
  data-enable-history-state="true"
  data-ajax="true"
  data-stock="{{ section.settings.stock_enable }}"
  data-handle="{{ product.handle }}"
  data-autoplay="{{ section.settings.e_autoplay }}"
  data-videoloop="{{ section.settings.e_loop }}"
> 
{% liquid
  assign breadcrumb_collection = collection
  if breadcrumb_collection == blank
    assign breadcrumb_collection = product.collections.first
  endif
%}

<nav class="product-breadcrumb only-desktop" aria-label="Breadcrumb">
  <a class="product-breadcrumb__link" href="{{ routes.root_url }}">
    Home
  </a>

  {% if breadcrumb_collection != blank %}
    <span class="product-breadcrumb__separator" aria-hidden="true">/</span>

    <a
      class="product-breadcrumb__link"
      href="{{ breadcrumb_collection.url }}"
    >
      {{ breadcrumb_collection.title | escape }}
    </a>
  {% endif %}

  <span class="product-breadcrumb__separator" aria-hidden="true">/</span>

  <span class="product-breadcrumb__current" aria-current="page">
    {{ product.title | escape }}
  </span>
</nav>

  {%- liquid
    assign current_variant = product.selected_or_first_available_variant
    assign left_size = 'col-md-6 col-12'
    assign right_size = 'col-md-6 col-12'
    case section.settings.media_size
      when 'small'
        assign left_size = 'col-md-5 col-12'
        assign right_size = 'col-md-7 col-12'
      when 'normal'
        assign left_size = 'col-md-6 col-12'
        assign right_size = 'col-md-6 col-12'
      when 'large'
        assign left_size = 'col-md-7 col-12'
        assign right_size = 'col-md-5 col-12'
      when 'largest'
        assign left_size = 'col-md-8 col-12'
        assign right_size = 'col-md-4 col-12'
    endcase
    assign featured_img = current_variant.featured_image | default: product.featured_image

    assign media_style = section.settings.media_style
  -%}
  <meta itemprop="name" content="{{ product.title }}">
  <meta itemprop="url" content="{{ shop.url }}{{ product.url }}">
  <meta itemprop="image" content="{{ product.featured_image.src | image_url: width: 600, height: 600 }}">
  <meta itemprop="brand" content="{{ product.vendor }}">

  <div class="row product-single">
    <div
      class="
        {{ left_size }}

          {% unless media_style == 'media-list' or media_style == 'media-grid' or media_style == 'media-collage-1' or media_style == 'media-collage-2' %}
          photos-sticky
        {% endunless %}
      "
    >
      {% render 'product-media-2',
        product: product,
        featured_image: featured_img,
        image_size: section.settings.image_size,
        loop: section.settings.enable_video_looping,
        media_style: section.settings.media_style
      %}
    </div>
    <div
      class="
        {{ right_size }} order-1
        {% if  media_style == 'media-list' or media_style == 'media-grid' or media_style == 'media-collage-1' or media_style == 'media-collage-2' %}
        photos-sticky
        {% endif %}
      "
      itemprop="offers"
      itemscope
      itemtype="http://schema.org/Offer"
    >
      <div class="product-single__info-wrapper">
        <meta itemprop="priceCurrency" content="{{ shop.currency }}">
        <link
          itemprop="availability"
          href="http://schema.org/{% if product.available %}InStock{% else %}OutOfStock{% endif %}"
        >
        <div class="product-single__meta small--text-center desktop-div">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when '@app' -%}
                {% render block %}
              {%- when 'text' -%}
                <p
                  class="product-block product__text{% if block.settings.text_style == 'uppercase' %} text-uppercase {% elsif block.settings.text_style == 'subtitle' %} subtop{% endif %}"
                  {{ block.shopify_attributes }}
                >
                  {{- block.settings.text -}}
                </p>
              {%- when 'title' -%}
                <div class="product-block product-title">
                  {%- if block.settings.e_label -%}
                    {% render 'product-label' %}
                  {%- endif -%}
                  <h1 itemprop="name" class="product-single__title">
                    {{ product.title }}
                  </h1>
                </div>

              {%- when 'icon_with_text' -%}
                {%- liquid
                  assign block_style = block.settings.block_style
                -%}

                <div class="product-block product-block__iwt">
                  <div class="product-trust-items iwt-{{ block_style }}">

                    {%- for i in (1..4) -%}
                      {%- liquid
                        assign icon = 'icon_' | append: i
                        assign text = 'icon_text_' | append: i
                        assign iconShow = block.settings[icon]
                        assign textShow = block.settings[text]
                      -%}

                      {%- if textShow != blank -%}
                        <div class="product-trust-item">

                          <span class="product-trust-item__icon">
                            {% case iconShow %}

                              {% when 'checkmark' %}
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                  <path d="M12 3l8 3v6c0 4.5-3.4 8.3-8 9-4.6-.7-8-4.5-8-9V6z"/>
                                  <path d="M8.5 12l2.5 2.5 4.5-5"/>
                                </svg>

                              {% when 'gift' %}
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                  <rect x="3" y="8" width="18" height="4" rx="1"/>
                                  <path d="M5 12v9h14v-9M12 8v13"/>
                                  <path d="M12 8H8.5a2.5 2.5 0 1 1 2.5-2.5V8zm0 0h3.5a2.5 2.5 0 1 0-2.5-2.5V8z"/>
                                </svg>

                              {% when 'globe' %}
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                  <circle cx="12" cy="12" r="9"/>
                                  <path d="M3 12h18M12 3a15 15 0 0 1 0 18M12 3a15 15 0 0 0 0 18"/>
                                </svg>

                              {% when 'heart' %}
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                  <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8l1.1 1.1L12 21l7.8-7.5 1.1-1.1a5.5 5.5 0 0 0-.1-7.8z"/>
                                </svg>

                              {% when 'leaf' %}
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                  <path d="M20 4C10 4 4 8 4 14a6 6 0 0 0 6 6c6 0 10-6 10-16z"/>
                                  <path d="M3 21c4-6 8-9 13-12"/>
                                </svg>

                              {% when 'lock' %}
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                  <rect x="4" y="10" width="16" height="11" rx="2"/>
                                  <path d="M8 10V7a4 4 0 0 1 8 0v3M12 14v3"/>
                                </svg>

                              {% when 'package' %}
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                  <path d="m12 3 9 5-9 5-9-5 9-5z"/>
                                  <path d="M3 8v9l9 5 9-5V8M12 13v9M7.5 5.5l9 5"/>
                                </svg>

                              {% when 'phone' %}
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                  <path d="M7 3H4a1 1 0 0 0-1 1c0 9.4 7.6 17 17 17a1 1 0 0 0 1-1v-3l-5-2-2 3a14 14 0 0 1-7-7l3-2-2-5z"/>
                                </svg>

                              {% when 'ribbon' %}
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                  <circle cx="12" cy="9" r="6"/>
                                  <path d="m8 14-1 8 5-3 5 3-1-8M9.5 9l1.7 1.7 3.3-3.4"/>
                                </svg>

                              {% when 'shield' %}
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                  <path d="M12 3l8 3v6c0 4.5-3.4 8.3-8 9-4.6-.7-8-4.5-8-9V6z"/>
                                  <path d="M8.5 12l2.5 2.5 4.5-5"/>
                                </svg>

                              {% when 'tag' %}
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                  <path d="M20 13 13 20 3 10V4h6z"/>
                                  <circle cx="7" cy="8" r="1"/>
                                </svg>

                              {% when 'truck' %}
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                  <path d="M3 6h11v11H3zM14 10h4l3 3v4h-7"/>
                                  <circle cx="7" cy="18" r="2"/>
                                  <circle cx="17" cy="18" r="2"/>
                                </svg>

                            {% endcase %}
                          </span>

                          <span class="product-trust-item__text">
                            {{ textShow }}
                          </span>

                        </div>
                      {%- endif -%}
                    {%- endfor -%}

                  </div>
                </div>

              {%- when 'guarantee_badge' -%}
                <div class="guarantee-badge product-block" {{ block.shopify_attributes }}>
                  <div class="guarantee-badge__icon">
                    {%- if block.settings.icon != blank -%}
                      <img
                        src="{{ block.settings.icon | image_url: width: 240 }}"
                        alt="{{ block.settings.icon.alt | default: block.settings.heading | escape }}"
                        width="{{ block.settings.icon.width }}"
                        height="{{ block.settings.icon.height }}"
                        loading="lazy"
                      >
                    {%- else -%}
                      <svg viewBox="0 0 120 120" aria-hidden="true">
                        <defs>
                          <linearGradient id="GuaranteeGold-{{ block.id }}" x1="0" y1="0" x2="1" y2="1">
                            <stop offset="0" stop-color="#e2b54a"/>
                            <stop offset="1" stop-color="#f7dc84"/>
                          </linearGradient>
                        </defs>
                        <path fill="url(#GuaranteeGold-{{ block.id }})" d="M60.0 12.0 A8.7 8.7 0 0 1 76.4 14.9 A8.7 8.7 0 0 1 90.9 23.2 A8.7 8.7 0 0 1 101.6 36.0 A8.7 8.7 0 0 1 107.3 51.7 A8.7 8.7 0 0 1 107.3 68.3 A8.7 8.7 0 0 1 101.6 84.0 A8.7 8.7 0 0 1 90.9 96.8 A8.7 8.7 0 0 1 76.4 105.1 A8.7 8.7 0 0 1 60.0 108.0 A8.7 8.7 0 0 1 43.6 105.1 A8.7 8.7 0 0 1 29.1 96.8 A8.7 8.7 0 0 1 18.4 84.0 A8.7 8.7 0 0 1 12.7 68.3 A8.7 8.7 0 0 1 12.7 51.7 A8.7 8.7 0 0 1 18.4 36.0 A8.7 8.7 0 0 1 29.1 23.2 A8.7 8.7 0 0 1 43.6 14.9 A8.7 8.7 0 0 1 60.0 12.0Z"/>
                        <circle cx="60" cy="60" r="36" fill="none" stroke="#111" stroke-width="3" stroke-dasharray="6 4.5"/>
                        <g transform="translate(43 38) scale(1.4)" fill="none" stroke="#111" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M14 9V5a3 3 0 0 0-3-3l-4 9v11h11.28a2 2 0 0 0 2-1.7l1.38-9a2 2 0 0 0-2-2.3zM7 22H4a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h3"/>
                        </g>
                        <path fill="#111" d="M60 76.5l2.1 4.3 4.7.7-3.4 3.3.8 4.7-4.2-2.2-4.2 2.2.8-4.7-3.4-3.3 4.7-.7z"/>
                      </svg>
                    {%- endif -%}
                  </div>
                  <div class="guarantee-badge__text">
                    {%- if block.settings.label != blank -%}
                      <span class="guarantee-badge__label">{{ block.settings.label | escape }}</span>
                    {%- endif -%}
                    {%- if block.settings.heading != blank -%}
                      <p class="guarantee-badge__heading">{{ block.settings.heading | escape }}</p>
                    {%- endif -%}
                    {%- if block.settings.text != blank -%}
                      <p class="guarantee-badge__body">{{ block.settings.text | escape }}</p>
                    {%- endif -%}
                  </div>
                </div>

              {%- when 'block_banner' -%}
                {%- liquid
                  assign banner_text = block.settings.banner_text
                  assign banner_des = block.settings.banner_des
                  assign banner_icon = block.settings.banner_icon
                  assign banner_icon_svg = block.settings.banner_icon_svg
                  assign banner_txt_color = block.settings.banner_txt_color
                  assign banner_bg_color = block.settings.banner_bg_color
                  assign banner_radius = block.settings.banner_radius
                -%}
                <style>
                  .product-block__banner{{ block.id }} .media{
                    border-radius: {{ banner_radius }}px;
                    background:{{ banner_bg_color }};
                    color: {{ banner_txt_color }};
                    --g-color-heading: {{ banner_txt_color }};
                    --color-body-text: {{ banner_txt_color }};
                  }
                </style>
                <div class="product-block product-block__banner product-block__banner{{ block.id }}">
                  <div class="media px-4 py-3">
                    {%- if banner_icon != blank -%}
                      <img
                        class="mr-3"
                        src="{{ banner_icon | image_url: width: 300 }}"
                        loading="lazy"
                        width="{{ banner_icon.width }}"
                        height="{{ banner_icon.height }}"
                        alt="{{ banner_icon.alt }}"
                      >
                    {% else %}
                      {%- if banner_icon_svg != blank -%}
                        <div class="mr-3 img_svg">
                          {{ banner_icon_svg }}
                        </div>
                      {%- endif -%}
                    {%- endif -%}
                    <div class="media-body">
                      {%- if banner_text != blank -%}
                        <h5 class="mt-0 mb-0">{{ banner_text }}</h5>
                      {%- endif -%}
                      {%- if banner_des != blank -%}
                        <div>{{ banner_des }}</div>
                      {%- endif -%}
                    </div>
                  </div>
                </div>
              {%- when 'custom_liquid' -%}
                {% if block.settings.custom_liquid != blank %}
                  <div class="product-block product-customliquid">
                    {{ block.settings.custom_liquid }}
                  </div>
                {% endif %}
              {%- when 'shortdesc' -%}
                <div class="product-block rte product-short__description txt-body-70">
                  {% if product.metafields.info.shortdesc != blank %}
                    {{ product.metafields.info.shortdesc }}
                  {% else %}
                    {{ product.description | strip_html | truncatewords: 20 }}
                  {% endif %}
                </div>

              {% when 'Bundle_product_new' %}
                {% render 'Bundle_product_new', block: block, product: product %}
                {% when 'custom_product_accordion' %}
                      {% render 'product-info-custom-accordion', block: block, product: product %}

              {%- when 'description' -%}
                {%- if block.settings.enable_tab -%}
                  <div class="accordion">
                    <div class="tabcustom collapsed h6" data-toggle="collapse" data-target="#tabp-{{ block.id }}">
                      {{ block.settings.title_tab | default: 'Description' }}
                    </div>
                    <div id="tabp-{{ block.id }}" class="collapse tab-content">
                      <div class="py-3">
                        {{ product.description }}
                      </div>
                    </div>
                  </div>
                {%- else -%}
                  <div class="product-block product-single__description" itemprop="description">
                    {{ product.description }}
                  </div>
                {%- endif -%}
                
              {% when 'shipping_notice' %}
                <div
                  class="shipping-notice"
                  {{ block.shopify_attributes }}
                >
                  <svg
                    class="shipping-notice__icon"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <rect x="3" y="8" width="18" height="4" rx="1"></rect>
                    <path d="M5 12v9h14v-9"></path>
                    <path d="M12 8v13"></path>
                    <path d="M12 8H8.5a2.5 2.5 0 1 1 0-5C11 3 12 8 12 8z"></path>
                    <path d="M12 8h3.5a2.5 2.5 0 0 0 0-5C13 3 12 8 12 8z"></path>
                  </svg>

                  <span>
                    {{ block.settings.prefix }}
                      {% assign days_to_add = block.settings.deadline | plus: 0 %}
                      {% assign seconds_to_add = days_to_add | times: 86400 %}
                      {% assign deadline_timestamp = 'now' | date: '%s' | plus: seconds_to_add %}
                      {% assign deadline_day = deadline_timestamp | date: '%-d' | plus: 0 %}

                      <strong data-shipping-deadline data-days="{{ days_to_add }}">
                        {{ deadline_timestamp | date: '%b %-d' }}{% case deadline_day %}
                          {% when 1 or 21 or 31 %}st
                          {% when 2 or 22 %}nd
                          {% when 3 or 23 %}rd
                          {% else %}th
                        {% endcase %}
                      </strong>
                    {{ block.settings.middle_text }}
                    <strong>{{ block.settings.shipping_text | escape }}</strong>
                    <span class="shipping-notice__suffix">{{ block.settings.suffix | escape }}</span>
                  </span>
                </div>

              {%- when 'review' -%}
                <div class="review product-block">
                  <span class="shopify-product-reviews-badge" data-id="{{ product.id }}"></span>
                </div>
              {%- when 'separator' -%}
                <hr>
              
               {%- when 'price' -%}
                <div class="custom-product-price">

                  <div class="custom-product-price__row">

                    {%- if block.settings.price_label != blank -%}
                      <span class="custom-product-price__label">
                        {{ block.settings.price_label | escape }}
                      </span>
                    {%- endif -%}

                    <span
                      id="ProductPrice-{{ section.id }}"
                      class="custom-product-price__current product-single__price"
                      itemprop="price"
                      content="{{ current_variant.price | divided_by: 100.00 }}"
                    >
                      {{ current_variant.price | money }}
                    </span>

                    {% if product.compare_at_price_max > product.price %}
                      <s
                        id="ComparePrice-{{ section.id }}"
                        class="custom-product-price__compare product-single__price--compare"
                      >
                        {{ current_variant.compare_at_price | money }}
                      </s>

                      {%- liquid
                        assign compare_price = current_variant.compare_at_price
                        assign current_price = current_variant.price

                        if compare_price > current_price and compare_price > 0
                          assign savings = compare_price | minus: current_price | times: 100.0
                          assign savings_percent = savings | divided_by: compare_price | round
                        endif
                      -%}

                      <span class="custom-product-price__badge">
                        SAVE {{ savings_percent }}%
                      </span>
                    {% endif %}

                  </div>

                  {%- if section.settings.stock_enable -%}
                    <div class="custom-product-price__stock">
                      {%- render 'productStock', current_variant: current_variant -%}
                    </div>
                  {%- endif -%}

                </div> 

                

              {%- when 'subscription_price' -%}
                {%- liquid
                  assign current_price = current_variant.price
                  assign compare_price = current_variant.compare_at_price
                  assign savings_amount = 0
                  assign savings_percent = 0

                  if compare_price > current_price and compare_price > 0
                    assign savings_amount = compare_price | minus: current_price
                    assign savings_percent = savings_amount | times: 100.0 | divided_by: compare_price | round
                  else
                    assign compare_price = current_price
                  endif

                  assign days_to_add = block.settings.deadline | default: 3 | plus: 0
                  assign seconds_to_add = days_to_add | times: 86400
                  assign deadline_timestamp = 'now' | date: '%s' | plus: seconds_to_add
                  assign deadline_day = deadline_timestamp | date: '%-d' | plus: 0
                -%}

                <div class="custom-product-price" id="CustomProductPrice-{{ section.id }}">

                  <div class="custom-product-price__heading">
                    <div class="custom-product-price__heading-row">
                      <span class="custom-product-price__headline"
                            data-price-savings-heading{% if block.settings.savings_heading != blank %} data-fixed-heading{% endif %}>
                        {%- if block.settings.savings_heading != blank -%}
                          {{ block.settings.savings_heading | escape }}
                        {%- else -%}
                          Save up to {{ savings_percent }}% off today
                        {%- endif -%}
                      </span>
                      {%- unless block.settings.hide_subheading -%}
                        <span class="custom-product-price__subheading">
                          with today’s Subscribe &amp; Save offer
                        </span>
                      {%- endunless -%}
                    </div>
                  </div>

                  <div class="custom-product-price__card">

                    <div class="custom-product-price__item">
                      <span class="custom-product-price__caption">Today’s Price</span>

                      <span
                        id="ProductPrice-{{ section.id }}"
                        class="custom-product-price__amount product-single__price"
                        itemprop="price"
                        content="{{ current_variant.price | divided_by: 100.0 }}"
                        data-current-price
                      >
                        {{ current_variant.price | money }}
                      </span>
                    </div>

                    <div class="custom-product-price__item custom-product-price__item--middle">
                      <span class="custom-product-price__caption">Original Price</span>

                      <s
                        id="ComparePrice-{{ section.id }}"
                        class="custom-product-price__original"
                        data-original-price
                      >
                        {{ compare_price | money }}
                      </s>
                    </div>

                    <div class="custom-product-price__item">
                      <span class="custom-product-price__caption custom-product-price__caption--savings">
                        Savings
                      </span>

                      <span class="custom-product-price__savings" data-savings-amount>
                        {{ savings_amount | money }}
                      </span>
                    </div>

                  </div>

                  {%- if section.settings.stock_enable -%}
                    <div class="custom-product-price__stock">
                      {%- render 'productStock', current_variant: current_variant -%}
                    </div>
                  {%- endif -%}

                </div>


                {% when 'product_swatches' %}
                  {% render 'product-swatches',
                    product: product,
                    block: block
                  %}
              {%- when 'salepoint' -%}
                <div class="product-block salepoint d-flex align-items-center">
                  {% case block.settings.icon %}
                    {% when 'checkmark' %}
                      <svg
                        aria-hidden="true"
                        focusable="false"
                        role="presentation"
                        class="icon icon-circle-checkmark"
                        viewBox="0 0 64 64"
                      >
                        <defs><style>.a{fill:none;stroke:#000;stroke-width:2px}</style></defs><path class="a" d="M52.68 24.48A22 22 0 1 1 47 15.93M21 32l8.5 8.5L57 13"/>
                      </svg>
                    {% when 'gift' %}
                      <svg
                        aria-hidden="true"
                        focusable="false"
                        role="presentation"
                        class="icon icon-gift"
                        viewBox="0 0 64 64"
                      >
