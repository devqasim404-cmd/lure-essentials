                                          {% for step in testimonialsteps %}
                                            <div class="cw-product-box">
                                              {% if step.lock_image != blank %}
                                                <img
                                                  src="{{ step.lock_image | img_url: 'master' }}"
                                                  height="auto"
                                                  width="auto"
                                                  loading="lazy"
                                                  class="lock_image"
