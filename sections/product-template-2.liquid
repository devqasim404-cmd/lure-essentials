                                              {%- endif %}
                                              <div class="price {% if step.lock_image != blank %}lock_product{% endif %}">
                                                <span>{{ step.gift_price }}</span>
                                              </div>
                                              <div class="cw-product-image {% if step.lock_image != blank %}lock_product{% endif %}">
                                                <img
                                                  src="{{ step.gift_image | img_url: 'master' }}"
                                                  height="auto"
                                                  width="auto"
                                                  loading="lazy"
                                                >
                                              </div>
