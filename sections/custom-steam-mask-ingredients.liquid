<section class="ingredients-section">
  <div class="container">
    <h2 class="heading">{{ section.settings.heading }}</h2>
    <div class="ingredients-inner">
      <div class="ingredients-left">
        {% if section.settings.product_image %}
          <img src="{{ section.settings.product_image | image_url }}" alt="Product" class="product-img">
        {% endif %}
        {% if section.settings.product_image_mob %}
          <img src="{{ section.settings.product_image_mob | image_url }}" alt="Product" class="product-img-mob">
        {% endif %}
        {% if section.settings.arrow_image %}
          <img src="{{ section.settings.arrow_image | image_url }}" alt="Arrow" class="arrow-img">
        {% endif %}
      </div>
      <div class="ingredients-right" style="--ingredient-box-width: {{ section.settings.box_width }};">
        {% for block in section.blocks %}
          <div class="ingredient-box">
            {% if block.settings.icon %}
              <img src="{{ block.settings.icon | image_url }}" alt="{{ block.settings.title }}">
            {% endif %}
            <h4>{{ block.settings.title }}</h4>
            <p>{{ block.settings.description }}</p>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

<style>
            .ingredients-section {
              background: {{ section.settings.background-color }};
              padding: 80px 20px 50px;
              text-align: center;
            }
            .ingredients-section .heading {
            color: #000;
          text-align: center;
          font-size: 60px;
          font-style: normal;
          font-weight: 700;
          line-height: 40px; /* 66.667% */
              margin-bottom: 120px;
            }
            .ingredients-inner {
              display: flex;
              justify-content: center;
              align-items: center;
              gap: 40px;
            }
            .ingredients-left {
              width: 40%;
              position: relative;
            }
            .ingredients-left img.product-img {
              width: 100%;
              height: auto;
            }
            .ingredients-left img.arrow-img {
              position: absolute;
              top: 35%;
              right: -50px;
              max-width: 100px;
            }
            .ingredients-right {
               width: 60%;
              display: flex;
              flex-wrap: wrap;
              gap: 20px;
            }
            .ingredient-box {
                 background: #fff;
              border: 1px solid {{ section.settings.text-color }};
              border-radius: 12px;
              padding: 16px;
              width: calc(var(--ingredient-box-width, 20%) - 20px);
              box-sizing: border-box;
              text-align: center;
              display: flex;
              flex-direction: column;
              align-items: center;
            }
            .ingredient-box img {
              max-width: 87px;
              height: 87px;
            }
            .ingredient-box h4 {
              color: {{ section.settings.text-color }};
              font-size: 16px;
              margin: 10px 0 7px;
              font-weight: 700;
            }
            .ingredient-box p {
              font-size: 13px;
              color: #333;
              line-height: 15px;
            }

            /* @media screen and (max-width: 768px) {
              .ingredients-inner {
                flex-direction: column;
              }
              .ingredients-right {
                flex-direction: row;
              }
              .ingredient-box {
                width: calc(50% - 20px);
              }
              .ingredients-left img.arrow-img {
                position: static;
                margin: 20px auto;
              }
              .ingredients-left, .ingredients-right {
              width: 100%;
          }
            }
            @media screen and (max-width: 480px) {
              .ingredient-box {
                width: 100%;
              }
              .ingredients-section .heading {
                font-size: 40px;
              }
              .ingredients-section {
            padding: 100px 20px 50px;
              }
            } */
     @media screen and (min-width: 769px) {
    .product-img-mob {
          display: none;
        }
     }
  @media (min-width: 1000px) and (max-width: 1400px) {
    .ingredient-box {
      width: calc(25% - 20px);
    }
  }

  @media (min-width: 769px) and (max-width: 999px) {
    .ingredient-box {
      width: calc(33.33% - 20px);
    }
  }
      @media screen and (max-width: 768px) {
        .ingredients-inner {
          flex-direction: column;
          gap: 40px;
        }

        .ingredients-left,
        .ingredients-right {
          width: 100%;
        }

        .ingredient-box {
          width: calc(33.33% - 13.33px); /* 3 per row with some gap */
          padding: 8px;
        }

        .ingredients-right {
          justify-content: left;
          gap: 10px;
        }

        .ingredients-left img.arrow-img {
          display: none; /* Hide arrow for cleaner mobile UI */
        }
        .ingredient-box img {
        max-width: 58px;
        height: 58px;
    }
        .ingredient-box h4
     {
        font-size: 12px;
     }
        .ingredient-box p {
        font-size: 12px;
          line-height: 15px;
        }
        .ingredients-section .heading {
          font-size: 36px;
          line-height: 1.2;
          margin-bottom: 50px;
        }
        .product-img {
          display: none;
        }
        .ingredients-left img.product-img-mob {
              width: 100%;
              height: auto;
            }
      }

      @media screen and (max-width: 480px) {
        .ingredient-box {
          width: calc(33.33% - 8px); /* Still 3 per row */
        }



        .ingredients-section {
          padding: 50px 20px 50px;
        }

      }
</style>
{% schema %}
{
  "name": "Steam Mask Ingredients",
  "settings": [
    {
      "type": "image_picker",
      "id": "product_image",
      "label": "Product Image"
    },
    {
      "type": "image_picker",
      "id": "product_image_mob",
      "label": "product image mob"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "default": "It's what's inside that counts"
    },
    {
      "type": "color_background",
      "id": "background-color",
      "label": "Background Color"
    },
    {
      "type": "color",
      "id": "text-color",
      "label": "Text Color",
      "default": "#BE0EE3"
    },
    {
  "type": "select",
  "id": "box_width",
  "label": "Ingredient Box Width",
  "default": "20%",
  "options": [
    { "value": "20%", "label": "5 per row (20%)" },
    { "value": "25%", "label": "4 per row (25%)" },
    { "value": "33.33%", "label": "3 per row (33.33%)" },
    { "value": "50%", "label": "2 per row (50%)" },
    { "value": "100%", "label": "1 per row (100%)" }
  ]
}
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description"
        }
      ]
    }
  ],
  "max_blocks": 15,
  "presets": [
    {
      "name": "Steam Mask Ingredients",
      "blocks": []
    }
  ]
}
{% endschema %}
