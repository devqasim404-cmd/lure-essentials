                                                  {{- step.lock_product_text -}}
                                                {%- else -%}
                                                  {{- step.gift_name -}}
                                                {%- endif -%}
                                              </span>
                                            </div>
                                          {% endfor %}
                                        {% endif %}
                                      </div>
                                    {% endif %}
                                  {% endfor %}
                                {% endfor %}
                              </div>
                            {% endif %}
                              <!-- ✅ Main HTML -->
