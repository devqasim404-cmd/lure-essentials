                                        fill="none"
                                      >
                                        <path d="M2 6.63136C2.51795 7.14931 5.23718 9.86854 6.53205 11.1634L15.5962 2.0993" stroke="#979493" stroke-width="2.58975" stroke-linecap="round"/>
                                      </svg>
                                      No Contract <span class="highlight">CANCEL EASILY</span>
                                    </li>
                                    <li>
                                      <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        width="17"
                                        height="13"
                                        viewBox="0 0 17 13"
                                        fill="none"
                                      >
                                        <path d="M2 6.63136C2.51795 7.14931 5.23718 9.86854 6.53205 11.1634L15.5962 2.0993" stroke="#979493" stroke-width="2.58975" stroke-linecap="round"/>
                                      </svg>
                                      20% OFF<span class="highlight"> FOR LIFE</span>
                                    </li>
                                    <li>
                                      <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        width="17"
                                        height="13"
                                        viewBox="0 0 17 13"
                                        fill="none"
                                      >
                                        <path d="M2 6.63136C2.51795 7.14931 5.23718 9.86854 6.53205 11.1634L15.5962 2.0993" stroke="#979493" stroke-width="2.58975" stroke-linecap="round"/>
                                      </svg>
                                      <span class="highlight">FREE</span> Gifts &amp; Store Discounts
                                    </li>
                                  </ul>
                                </div>

                                <div class="option onetime-option" data-type="onetime">
                                  <label>
                                    <div>
                                      <input type="radio" name="purchase_option">
                                      <span class="custom-radio"></span>
                                      <span class="label-text">One-Time Purchase</span>
                                    </div>
                                    <span class="price onetime-price">$273.99</span>
                                  </label>
                                  <div class="sls-subscribe-info" style="display:none;">
                                    <div class="subscribe-offer-grid">
                                      <div class="offer-main">
                                        <div class="offer-hand-icon">
                                          <img
                                            src="https://cdn.shopify.com/s/files/1/1652/5029/files/ef5f2348560932a8e4ab199f38ca6cb2199277fe.png?v=1749219546"
                                            class="image_undown"
                                          >
                                        </div>
                                        <div>
                                          <div class="offer-title">If You Subscribe</div>
                                          <div class="offer-price-row">
                                            <span class="offer-price"
                                              >$60.89/ <span class="offer-month">Month</span></span
                                            >
                                          </div>
                                          <div class="offer-save-row">
                                            <span class="offer-save-btn">Save $18.00</span>
                                            <span class="offer-cross-price">$91.33</span>
                                          </div>
                                        </div>
                                      </div>
                                      <div class="offer-features_div">
                                        <div class="offer-features">
                                          <ul>
                                            <li>
                                              <span class="checkmark">✔</span>
                                              <span
                                                ><span class="feature-pink">FREE SHIPPING</span> on first order</span
                                              >
                                            </li>
                                            <li>
                                              <span class="checkmark">✔</span>
                                              <span>20% OFF <span class="feature-pink">FOR LIFE</span></span>
                                            </li>
                                          </ul>
                                        </div>
