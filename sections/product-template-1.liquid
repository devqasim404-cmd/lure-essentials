<script>
  document.addEventListener("DOMContentLoaded", function () {
    // Select all radio inputs
    const radios = document.querySelectorAll('input[name="free-gift-varient"]');
 
    radios.forEach(function (radio) {
      radio.addEventListener('change', function () {
        const variantName = radio.getAttribute('data-varient-name');
        const strength = radio.getAttribute('data-strenth');
 
        // Select the element where the text should be updated
        const displaySpan = document.querySelector('.js-swatch-display--1');
 
        if (displaySpan && variantName && strength) {
          displaySpan.innerHTML = `${variantName} <span class="variant-strenth"> ${strength}</span>`;
        }
      });
    });
 
    // Also run once on page load for default checked radio
    const checked = document.querySelector('input[name="free-gift-varient"]:checked');
    if (checked) {
      const variantName = checked.getAttribute('data-varient-name');
        const strength = checked.getAttribute('data-strenth');
 
        // Select the element where the text should be updated
        const displaySpan = document.querySelector('.js-swatch-display--1');
 
        if (displaySpan && variantName && strength) {
          displaySpan.innerHTML = `${variantName} <span class="variant-strenth"> ${strength}</span>`;
        }
    }
  });
</script>

