<script>
  document.addEventListener("DOMContentLoaded", function () {
    const variantRadios = document.querySelectorAll('input[name="free-gift-varient"]');
    const inputVariantName = document.getElementById('varient-name');
    const inputVariantGift = document.getElementById('varient-gift');

    variantRadios.forEach(radio => {
      radio.addEventListener("change", function () {
        const selectedName = this.getAttribute("data-varient-name") || '';
        const selectedGift = this.getAttribute("data-varient-gift") || '';

        // Update hidden inputs
        inputVariantName.value = selectedName;
        inputVariantGift.value = selectedGift;

        // Optional: Also update the variant dropdown to match selected
        const variantId = this.getAttribute("data-varient")?.replace('option', '');
        if (variantId) {
          const variantSelect = document.querySelector('select[name="id"]');
          if (variantSelect) {
            variantSelect.value = variantId;
            variantSelect.dispatchEvent(new Event("change", { bubbles: true }));
          }
        }

        // Optional: Show/hide gift preview section
        document.querySelectorAll('.variantidGroup').forEach(group => {
          group.style.display = group.dataset.variantId === variantId ? 'flex' : 'none';
        });
      });
    });

    // Trigger change on load if one is already selected
    const selected = document.querySelector('input[name="free-gift-varient"]:checked');
    if (selected) selected.dispatchEvent(new Event('change'));
  });
</script>

