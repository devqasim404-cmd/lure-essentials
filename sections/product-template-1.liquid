<script>
  document.addEventListener("DOMContentLoaded", function () {
    const radios = document.querySelectorAll('input[name="free-gift-varient"]');
    const variantGroups = document.querySelectorAll(".variantidGroup");

    function updateVariantDisplay() {
      const selected = document.querySelector('input[name="free-gift-varient"]:checked');
      const selectedVariant = selected?.getAttribute("data-varient")?.replace("option", "");

      variantGroups.forEach(group => {
        const groupId = group.getAttribute("data-variant-id");
        if (groupId === selectedVariant) {
          group.style.display = "flex";
        } else {
          group.style.display = "none";
        }
      });
    }

    // Initial load
    updateVariantDisplay();

    // On change
    radios.forEach(radio => {
      radio.addEventListener("change", updateVariantDisplay);
    });
  });
</script>
