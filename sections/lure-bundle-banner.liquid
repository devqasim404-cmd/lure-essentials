{%- comment -%}
  Bundle page banner (Lure Essentials)
  ------------------------------------------------------------------
  Image banner for the "Build your own bundle" page template. Add it in the
  theme editor ABOVE the Appstle dynamic bundle section.

  Images:
  - Desktop/tablet (640px and up): the banner image, shown whole.
  - Phones (639px and below): the "Mobile banner image" if one is chosen,
    shown whole at its own shape. If none is chosen, phones show the left part
    of the desktop image, larger, so the text stays readable.

  Clicking the banner scrolls down to the products, stopping just below the
  sticky header and the discount bar.
{%- endcomment -%}

{%- liquid
  assign img = section.settings.image
  assign img_mobile = section.settings.image_mobile
  assign alt = section.settings.alt | default: img.alt
-%}

<style>
  .lure-bb {
    box-sizing: border-box;
    width: calc(100% - 80px);
    max-width: 1200px;
    margin: 32px auto 40px;
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 18px 44px rgba(20, 26, 92, 0.12);
  }
  .lure-bb__link { display: block; line-height: 0; }
  .lure-bb__link:focus-visible { outline: 2px solid #2f8fe8; outline-offset: 4px; }
  .lure-bb__img { display: block; width: 100%; height: auto; }
  .lure-bb__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 2000 / 714;
    padding: 24px;
    background: #f5faff;
    border: 1.5px dashed #b7becc;
    border-radius: 24px;
    color: #4a5170;
    font-size: 15px;
    line-height: 1.5;
    text-align: center;
  }
  @media (max-width: 639px) {
    .lure-bb {
      width: calc(100% - 32px);
      margin: 12px auto 20px;
      border-radius: 18px;
    }
    /* phones without a mobile image: crop to the left ~48% of the desktop image
       (text block and button), so the words are about twice as big */
    .lure-bb:not(.lure-bb--has-mobile) .lure-bb__img {
      aspect-ratio: 960 / 714;
      height: auto;
      object-fit: cover;
      object-position: 0% 50%;
    }
  }
</style>

{%- if img != blank -%}
  <div class="lure-bb{% if img_mobile != blank %} lure-bb--has-mobile{% endif %}">
    <a class="lure-bb__link" href="#bundle-products" data-lure-bb-scroll aria-label="{{ alt | escape }}">
      {%- if img_mobile != blank -%}
        <picture>
          <source
            media="(max-width: 639px)"
            srcset="{{ img_mobile | image_url: width: 600 }} 600w, {{ img_mobile | image_url: width: 900 }} 900w, {{ img_mobile | image_url: width: 1200 }} 1200w"
            sizes="calc(100vw - 32px)"
            width="{{ img_mobile.width }}"
            height="{{ img_mobile.height }}"
          >
          {{
            img
            | image_url: width: 2400
            | image_tag:
              loading: 'eager',
              fetchpriority: 'high',
              widths: '800, 1200, 1600, 2000, 2400',
              sizes: '(min-width: 1280px) 1200px, calc(100vw - 80px)',
              alt: alt,
              class: 'lure-bb__img'
          }}
        </picture>
      {%- else -%}
        {{
          img
          | image_url: width: 2400
          | image_tag:
            loading: 'eager',
            fetchpriority: 'high',
            widths: '800, 1200, 1600, 2000, 2400',
            sizes: '(min-width: 1280px) 1200px, (min-width: 640px) calc(100vw - 80px), calc((100vw - 32px) * 2.1)',
            alt: alt,
            class: 'lure-bb__img'
        }}
      {%- endif -%}
    </a>
  </div>

  <script>
    (function () {
      if (window.lureBundleBannerScroll) return;
      window.lureBundleBannerScroll = true;
      document.addEventListener('click', function (e) {
        var a = e.target.closest('[data-lure-bb-scroll]');
        if (!a) return;
        e.preventDefault();
        var root = document.querySelector('#appstleBundlesPageRoot');
        var target = root && root.querySelector('.ab-product-list-container, .ab-products-list');
        if (!target) return;
        // stop below what is stuck to the top: the theme's sticky header and, on
        // desktop, Appstle's sticky discount bar (on phones the bar sits at the bottom)
        var offset = 16;
        var header = document.querySelector('header.site-header--sticky');
        if (header) offset += header.offsetHeight;
        var bar = root.querySelector('.ab-tiered-discount-progress-step-container');
        if (bar) {
          var s = getComputedStyle(bar);
          if ((s.position === 'sticky' || s.position === 'fixed') && s.bottom !== '0px') offset += bar.offsetHeight;
        }
        var top = target.getBoundingClientRect().top + window.pageYOffset - offset;
        var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        window.scrollTo({ top: Math.max(0, top), behavior: reduce ? 'auto' : 'smooth' });
      });
    })();
  </script>
{%- elsif request.design_mode -%}
  <div class="lure-bb" style="box-shadow: none">
    <div class="lure-bb__placeholder">Bundle page banner: choose a banner image in this section's settings.</div>
  </div>
{%- endif -%}

{%- comment -%}
  Offer prices on the Appstle bundle products, the same way the collection cards
  show them: the product field custom.offer_price (Money or Decimal), when lower
  than the price, is shown with the regular price struck through. Appstle's cards
  only carry the product title, so products are matched by title. The amounts are
  scaled from the price Appstle shows, so they follow the shopper's currency.
{%- endcomment -%}
{%- if section.settings.show_offer_prices -%}
  {%- liquid
    assign offer_collection = section.settings.offer_collection
    if offer_collection == blank
      assign offer_collection = collections['all']
    endif
  -%}
  {%- capture lure_offers -%}
    {%- paginate offer_collection.products by 250 -%}
      {%- for p in offer_collection.products -%}
        {%- liquid
          assign offer_cents = 0
          assign offer_field = p.metafields.custom.offer_price
          if offer_field != blank
            if offer_field.type == 'money'
              assign offer_cents = offer_field.value | money_without_currency | remove: ',' | times: 100 | round
            else
              assign offer_cents = offer_field.value | times: 100 | round
            endif
          endif
        -%}
        {%- if offer_cents > 0 -%}
          {{ p.title | strip | json }}:[{{ offer_cents }},{{ p.price }}],
        {%- endif -%}
      {%- endfor -%}
    {%- endpaginate -%}
  {%- endcapture -%}

  <style>
    #appstleBundlesPageRoot .lure-bb-price,
    .ab-dynamic-pricing-bundle .lure-bb-price {
      width: 100%;
      margin: 8px 0 0;
      color: #1a1a1a;
      font-size: 20px;
      line-height: 1.3;
      text-align: center;
    }
    .lure-bb-price s {
      margin-left: 8px;
      color: #6b6b6b;
      font-size: 0.8em;
    }
    {%- if section.settings.hide_button_price %}
      .ab-dynamic-pricing-bundle .lure-bb-has-offer .ab-add-to-bundle-button-content .ab-product-variant-price,
      .ab-dynamic-pricing-bundle .lure-bb-has-offer .ab-add-to-bundle-button-content .ab-price-separator {
        display: none;
      }
    {%- endif %}
    @media (max-width: 639px) {
      .ab-dynamic-pricing-bundle .lure-bb-price { font-size: 16px; }
    }
  </style>

  <script>
    (function () {
      if (window.lureBundleOffers) return;
      var offers = { {{ lure_offers | strip | remove_last: ',' }} };
      window.lureBundleOffers = offers;
      var labels = {
        sale: {{ 'products.product.sale_price' | t | json }},
        regular: {{ 'products.product.regular_price' | t | json }}
      };
      var shopCurrency = {{ shop.currency | json }};
      var cur = window.Shopify && window.Shopify.currency;
      var rate = cur && cur.active !== shopCurrency ? parseFloat(cur.rate) || 1 : 1;

      // Read a formatted price like "$24.99", "Rs.7,100" or "24,99 €".
      function parse(text) {
        var m = text.match(/\d[\d.,\s]*\d|\d/);
        if (!m) return null;
        var num = m[0].replace(/\s/g, '');
        var dec = /[.,]\d{2}$/.test(num) ? num.charAt(num.length - 3) : '';
        var thou = (num.slice(0, dec ? -3 : undefined).match(/[.,]/) || [''])[0];
        var digits = num.replace(/[^\d]/g, '');
        return {
          raw: m[0],
          value: parseInt(digits, 10) / (dec ? 100 : 1),
          dec: dec,
          thou: thou || (dec === ',' ? '.' : ',')
        };
      }

      function format(p, value) {
        var parts = value.toFixed(p.dec ? 2 : 0).split('.');
        var whole = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, p.thou);
        return p.text.replace(p.raw, p.dec ? whole + p.dec + parts[1] : whole);
      }

      function apply() {
        var cards = document.querySelectorAll('.ab-dynamic-pricing-bundle .ab-product-list-item');
        for (var i = 0; i < cards.length; i++) {
          var card = cards[i];
          var titleEl = card.querySelector('.ab-product-title');
          var priceEl = card.querySelector('.ab-product-variant-price');
          var info = card.querySelector('.ab-product-info-details');
          if (!titleEl || !priceEl || !info) continue;
          var offer = offers[titleEl.textContent.trim()];
          var text = priceEl.textContent.trim();
          var line = card.querySelector('.lure-bb-price');
          var p = offer && offer[0] * rate < offer[1] ? parse(text) : null;
          if (!p) {
            if (line) line.remove();
            card.classList.remove('lure-bb-has-offer');
            continue;
          }
          if (line && line.getAttribute('data-from') === text) continue;
          p.text = text;
          var offerText = format(p, p.value * (offer[0] * rate) / offer[1]);
          if (!line) {
            line = document.createElement('div');
            line.className = 'lure-bb-price';
            info.insertAdjacentElement('afterend', line);
          }
          line.setAttribute('data-from', text);
          line.innerHTML =
            '<span class="visually-hidden"></span><span class="lure-bb-price__offer"></span>' +
            '<span class="visually-hidden"></span><s class="lure-bb-price__regular"></s>';
          var spans = line.children;
          spans[0].textContent = labels.sale;
          spans[1].textContent = offerText;
          spans[2].textContent = labels.regular;
          spans[3].textContent = text;
          card.classList.add('lure-bb-has-offer');
        }
      }

      var queued = false;
      function schedule() {
        if (queued) return;
        queued = true;
        requestAnimationFrame(function () {
          queued = false;
          apply();
        });
      }
      // Appstle draws and redraws its product list after the page loads.
      new MutationObserver(function (records) {
        for (var i = 0; i < records.length; i++) {
          var t = records[i].target;
          var el = t.nodeType === 1 ? t : t.parentElement;
          if (el && !el.closest('.lure-bb-price')) return schedule();
        }
      }).observe(document.body, { childList: true, subtree: true, characterData: true });
      schedule();
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Bundle page banner",
  "class": "lure-bundle-banner-section",
  "disabled_on": {
    "groups": ["header", "footer", "aside"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Banner for the \"Build your own bundle\" page. Place it above the Appstle bundle section."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Banner image (desktop)",
      "info": "Wide image, about 2000 × 714 px or larger. Used on tablets and desktops, and on phones when no mobile image is chosen."
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile banner image (optional)",
      "info": "Shown on phones (below 640px wide), whole, at its own shape. About 1080 px wide; e.g. 1080 × 1080 or 1080 × 1350. Leave empty to show the left part of the desktop image instead."
    },
    {
      "type": "text",
      "id": "alt",
      "label": "Image description (alt text)",
      "default": "Early Black Friday Deals: Mix, Match & Save. Buy 2 get 20% off, buy 3 get 25% off, buy 4 or more get 30% off.",
      "info": "Read out by screen readers. Describe the text in the image."
    },
    {
      "type": "header",
      "content": "Offer prices on bundle products"
    },
    {
      "type": "checkbox",
      "id": "show_offer_prices",
      "label": "Show offer prices",
      "default": true,
      "info": "Shows the product field \"custom.offer_price\" under each bundle product with the regular price struck through, like the collection pages."
    },
    {
      "type": "collection",
      "id": "offer_collection",
      "label": "Collection with the bundle products",
      "info": "Where offer prices are read from. Leave empty to use all products."
    },
    {
      "type": "checkbox",
      "id": "hide_button_price",
      "label": "Hide the price on the \"Add to Bundle\" button",
      "default": true,
      "info": "Only for products that show an offer price."
    }
  ],
  "presets": [
    {
      "name": "Bundle page banner"
    }
  ]
}
{% endschema %}
