{% if section.settings.topimage != blank -%}
  <img class="sec-top-img" src="{{ section.settings.topimage | img_url: 'master'  }}">
{%- endif %}
<section class="how-to-use-section top_background_use">
  <div class="container">
    <h2 class="how-title">How to Use:</h2>
    <div class="how-steps">
      {% for block in section.blocks %}
        <div class="how-step">
          <div class="step-icon">
            <img src="{{ block.settings.step_image | img_url: '300x' }}" alt="Step {{ forloop.index }}">
          </div>
          <h3 class="step-title">STEP {{ forloop.index }}</h3>
          <p class="step-text">{{ block.settings.step_description }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<style>
      .how-to-use-section {
        text-align: center;
        position: relative;
    }
    .top_background_use{
      background: {{ section.settings.background-color }};
    padding-bottom: 50px;
    }
    .how-to-use-section .how-title {
        padding-top: 70px;
        padding-bottom: 70px;
        color: #FFF;
        text-align: center;
        font-size: 60px;
        font-style: normal;
        font-weight: 700;
        line-height: 40px; /* 66.667% */
        {% comment %} text-transform: capitalize; {% endcomment %}
        font-family: 'HarmoniaSansW01';
    }
      .how-steps {
      display: grid;
      justify-content: center;
      gap: 40px;
      grid-template-columns: 1fr 1fr 1fr;
  }
      .how-step {
      }
      .step-icon {
        display: flex;
        align-items: center;
        justify-content: center;
            margin-bottom: 20px;
      }
      .step-icon img {
        max-width: 100%;
        height: auto;
      }
      .step-title {
        color: {{ section.settings.textcolor }};
        font-size: 28px;
        font-style: normal;
        font-weight: 700;
        line-height: 40px; /* 142.857% */
        text-transform: uppercase;
        margin-bottom: 10px;
        font-family: 'HarmoniaSansW01';
      }
    .step-text {
       color: {{ section.settings.textcolor }};
      text-align: center;
      font-size: 18px;
      font-style: normal;
      font-weight: 400;
      line-height: 29px;
      max-width: 334px;
      margin: 0 auto;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
      text-overflow: ellipsis;
      max-height: 4.5em;
      line-height: 1.5em;
  }
  @media (max-width: 767px){
     .step-icon img {
        max-width: 40%;
        height: auto;
      }
    .how-steps {
      grid-template-columns: 1fr;
  }
    .step-title {
    font-size: 32px;
    }
    .how-to-use-section .how-title {
  font-size: 40px;
    }
    .step-text {
    -webkit-line-clamp: 4;
      max-height: 8.5em;
    }
    .top_background_use{
    padding-bottom: 20px;
    }
  }
    @media (max-width: 767px) {
          .top_background_use {
        padding-bottom: 20px;
    }
      .step-icon{
        padding:20px;
        order: 2;
      }
      .how-step {
        display: flex;
        flex-direction: column;
     }   
    .how-steps {
        grid-template-columns: 1fr;
        gap: 0px;
    }
    .how-to-use-section .how-title {
        font-size: 40px;
      padding:20px;
    }
    .step-title {
        font-size: 32px;
       padding:20px;
    }
          .step-text {
        -webkit-line-clamp: 4;
        max-height: 8.5em;
             padding:20px;
    }
     


}
</style>

{% schema %}
{
  "name": "Multi Colum",
  "settings": [
    {
      "type": "image_picker",
      "id": "topimage",
      "label": "Top image"
    },
    {
      "type": "color_background",
       "id": "background-color",
      "label": "Background Color"
    },
    {
      "type": "color",
      "id": "textcolor",
      "label": "Text Color",
      "default": "#fff",
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "image_picker",
          "id": "step_image",
          "label": "Step Image"
        },
        {
          "type": "textarea",
          "id": "step_description",
          "label": "Step Description"
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Multi Colum",
      "blocks": [
        { "type": "step" },
        { "type": "step" },
        { "type": "step" }
      ]
    }
  ]
}
{% endschema %}
