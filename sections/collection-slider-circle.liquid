<link rel="stylesheet" href="https://unpkg.com/swiper@8/swiper-bundle.min.css"/>

{%- liquid
  assign padding_horizontal = section.settings.padding_horizontal
  assign padding_horizontal_mobile = section.settings.padding_horizontal_mobile
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
  assign background_color = section.settings.background_color
  assign background_gradient = section.settings.background_gradient
  assign full_width = section.settings.full_width
  assign content_width = section.settings.content_width
  assign lazy = section.settings.lazy
  assign icon_size = section.settings.icon_size
  assign icon_size_mobile = section.settings.icon_size_mobile
  assign icon_border_thickness = section.settings.icon_border_thickness
  assign icon_border_color = section.settings.icon_border_color
  assign icon_square = section.settings.icon_square
  assign text_size = section.settings.text_size
  assign text_size_mobile = section.settings.text_size_mobile
  assign text_color = section.settings.text_color
  assign text_height = section.settings.text_height
  assign text_mt = section.settings.text_mt
-%}

{% if template == 'index' %}
<style>
  .section-{{ section.id }} {
    background-color: {{ background_color }};
    background-image: {{ background_gradient }};
    padding: {{ padding_top }}px {{ padding_horizontal }}rem {{ padding_bottom }}px;
  }

  .circle-slider-{{ section.id }} {
    width: 100%;
  }

  .circle-item-{{ section.id }} {
    text-align: center;
  }

  .circle-icon-{{ section.id }} {
    margin: 0 auto;
    display: block;
    width: {{ icon_size_mobile }}px;
    height: {{ icon_size_mobile }}px;
    border: {{ icon_border_thickness }}px solid {{ icon_border_color }};
    border-radius: 50%;
    overflow: hidden;
    
  }
.circle-icon-{{ section.id }} img {
  width: 100%;
  height: 100%;
  object-fit: contain !important; /* Fit image properly */
  background-color: #ffffff; /* Optional: fills empty space */
}
  .circle-text-{{ section.id }} {
    margin-top: {{ text_mt }}px;
    font-size: {{ text_size_mobile }}px;
    color: {{ text_color }};
    line-height: {{ text_height }}%;
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: calc({{ icon_size_mobile }}px + 50px);
    margin-left: auto;
    margin-right: auto;
  }

  @media screen and (min-width: 1024px) {
    .circle-slider-{{ section.id }} .swiper-wrapper {
     display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 100px; /* ← DESKTOP GAP UPDATED */
    }

    .circle-item-{{ section.id }} {
      width: auto;
      max-width: calc({{ icon_size }}px + 70px);
    }

    .circle-icon-{{ section.id }} {
      width: {{ icon_size }}px;
      height: {{ icon_size }}px;
    }
.circle-icon-{{ section.id }} img {
  width: 100%;
  height: 100%;
  object-fit: contain !important; /* Fit image properly */
}

    .circle-text-{{ section.id }} {
      font-size: {{ text_size }}px;
      max-width: calc({{ icon_size }}px + 80px);
    }
  }

 @media screen and (max-width: 1023px) {
  .section-{{ section.id }} {
    padding-left: 0 !important;
    padding-right: 0 !important;
  }

  .circle-slider-{{ section.id }} {
    padding-left: 0 !important;
    padding-right: 0 !important;
    width: 100% !important;
  }

  .circle-slider-{{ section.id }} .swiper-wrapper {
    margin-left: 0 !important;
    margin-right: 0 !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
    flex-wrap: nowrap !important;
  }

  .circle-item-{{ section.id }} {
    width: auto;
    margin-right: 12px;
  }
}
</style>

<div class="section-{{ section.id }}">
  <div class="swiper circle-slider-{{ section.id }}">
    <div class="swiper-wrapper">
      {% for block in section.blocks %}
        <div class="circle-item-{{ section.id }} swiper-slide">
          <a href="{{ block.settings.bubble_link }}">
            <div class="circle-icon-{{ section.id }}">
              {% if block.settings.bubble_img %}
                
                <!-- ⭐ HIGH-RES ANTI-BLUR IMAGE ⭐ -->
                <img 
                  src="{{ block.settings.bubble_img | image_url: width: 800 }}"
                  srcset="
                    {{ block.settings.bubble_img | image_url: width: 200 }} 200w,
                    {{ block.settings.bubble_img | image_url: width: 400 }} 400w,
                    {{ block.settings.bubble_img | image_url: width: 600 }} 600w,
                    {{ block.settings.bubble_img | image_url: width: 800 }} 800w
                  "
                  sizes="(max-width: 768px) {{ icon_size_mobile }}px, {{ icon_size }}px"
                  alt="{{ block.settings.bubble_text }}"
                  loading="lazy"
                />

              {% else %}
                {{ 'image' | placeholder_svg_tag }}
              {% endif %}
            </div>
          </a>
          {% if block.settings.bubble_text != blank %}
            <p class="circle-text-{{ section.id }}">{{ block.settings.bubble_text }}</p>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</div>

<script src="https://unpkg.com/swiper@8/swiper-bundle.min.js"></script>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    if (window.innerWidth < 1024) {
      new Swiper('.circle-slider-{{ section.id }}', {
        slidesPerView: 'auto',
        spaceBetween: 12,
        freeMode: true,
        grabCursor: true,
      });
    }
  });
</script>
{% endif %}

{% schema %}
{
  "name": "Circle Menu",
  "settings": [
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon Size Desktop",
      "min": 20,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 70
    },
    {
      "type": "range",
      "id": "icon_size_mobile",
      "label": "Icon Size Mobile",
      "min": 20,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 46
    },
    {
      "type": "color",
      "id": "icon_border_color",
      "label": "Border Color",
      "default": "#f7b5c3"
    },
    {
      "type": "range",
      "id": "icon_border_thickness",
      "label": "Border Thickness",
      "min": 0,
      "max": 5,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text Size Desktop",
      "min": 8,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "text_size_mobile",
      "label": "Text Size Mobile",
      "min": 8,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 10
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color_background",
      "id": "background_gradient",
      "label": "Background Gradient"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "label": "Padding Sides (Desktop)",
      "min": 0,
      "max": 15,
      "step": 1,
      "unit": "rem",
      "default": 5
    },
    {
      "type": "range",
      "id": "padding_horizontal_mobile",
      "label": "Padding Sides (Mobile)",
      "min": 0,
      "max": 10,
      "step": 0.5,
      "unit": "rem",
      "default": 1.5
    }
  ],
  "blocks": [
    {
      "type": "menu_item",
      "name": "Menu Item",
      "settings": [
        { "type": "image_picker", "id": "bubble_img", "label": "Image" },
        { "type": "text", "id": "bubble_text", "label": "Text", "default": "Collection" },
        { "type": "url", "id": "bubble_link", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "Circle Menu" }]
}
{% endschema %}
