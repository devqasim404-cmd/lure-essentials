  <script>
document.addEventListener('DOMContentLoaded', function() {
  document.body.addEventListener('click', function(e) {
    const playIcon = e.target.closest('.play-iconn');
    if (!playIcon) return;

    const id = playIcon.getAttribute('data-video');
    const video = document.getElementById(id);
    const iconImg = playIcon.querySelector('img');

    if (video.paused) {
      // 1) Keep the poster visible by forcing a frame refresh
      video.style.display = 'block'; // Ensure video is visible
      video.load(); // Force browser to refresh video rendering

      // 2) Disable Shopify’s lazy-loader on desktop videos
      video.removeAttribute('loading');
      video.classList.remove('lazy');

      // 3) Play the video while keeping the poster visible
      video.muted = false; // Ensure sound is enabled
      video.currentTime = 0.05; // Start slightly after 0 to avoid black frame
      video.play();

      // 4) Hide play icon
      iconImg.style.display = 'none';
    } else {
      video.pause();
      iconImg.style.display = 'block';
    }
  });

  // Sync play icon with video state
  document.querySelectorAll('.video-player').forEach(video => {
    const pid = video.id;
    const playIcon = document.querySelector(`.play-iconn[data-video="${pid}"] img`);
    video.addEventListener('play', () => playIcon.style.display = 'none');
    video.addEventListener('pause', () => playIcon.style.display = 'block');
  });

  // Initialize Swiper
  if (typeof Swiper !== 'undefined') {
    new Swiper('.video-swiper-centered', {
      slidesPerView: 1,
      loop: false,
      navigation: {
        nextEl: '.swiper-button-next',
        prevEl: '.swiper-button-prev'
      },
    });
  }
});
  </script>
