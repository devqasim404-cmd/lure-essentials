<link rel="stylesheet" href="https://unpkg.com/swiper/swiper-bundle.min.css">

{%- if section.settings.section_topimg != blank -%}
  <img class="sec-top-img" src="{{ section.settings.section_topimg | img_url: 'master' }}">
{%- endif -%}
<div class="secbgcolor" id="innersection-{{ section.id }}">
  {%- if section.blocks.size > 0 -%}
    <section class="testimonials-section hdt-container wrapper">
      <div class="container">
        <div class="content-custom">
          <p class="testimonial-subtitle">{{ section.settings.subheading_text }}</p>
          <h2 class="testimonial-title">{{ section.settings.heading_text }}</h2>
        </div>
        <div class="testimonial-cards two-column">
          {% if section.settings.videobk1 != blank %}
            <div class="three-video-block full-width">
              <div class="testimonial-card half-width">
                {% if section.settings.videobk1 != blank %}
                  {{
                    section.settings.videobk1
                    | video_tag:
                      image_size: '1100x',
                      autoplay: false,
                      loop: true,
                      playsinline: true,
                      muted: true,
                      id: 'background-video',
                      class: 'lazy only-tablete block-image'
                  }}
                {% else %}
                  {% if section.settings.image != blank %}
                    <img src="{{ section.settings.image | img_url: 'master' }}" class="block-image">
                  {%- endif %}
                {% endif %}
              </div>
              {% if section.settings.videobk2 != blank %}
                <div class="testimonial-card half-width">
                  {% if section.settings.videobk2 != blank %}
                    {{
                      section.settings.videobk2
                      | video_tag:
                        image_size: '1100x',
                        autoplay: false,
                        loop: true,
                        playsinline: true,
                        muted: false,
                        id: 'background-video',
                        class: 'lazy only-tablete block-image'
                    }}
                  {% else %}
                    {% if section.settings.image != blank %}
                      <img src="{{ section.settings.image | img_url: 'master' }}" class="block-image">
                    {%- endif %}
                  {% endif %}
                </div>
              {% endif %}
              {% if section.settings.videobk3 != blank %}
                <div class="testimonial-card half-width">
                  {% if section.settings.videobk3 != blank %}
                    {{
                      section.settings.videobk3
                      | video_tag:
                        image_size: '1100x',
                        autoplay: false,
                        loop: true,
                        playsinline: true,
                        muted: false,
                        id: 'background-video',
                        class: 'lazy only-tablete block-image'
                    }}
                  {% else %}
                    {% if section.settings.image != blank %}
                      <img src="{{ section.settings.image | img_url: 'master' }}" class="block-image">
                    {%- endif %}
                  {% endif %}
                </div>
              {% endif %}
            </div>
          {% endif %}

