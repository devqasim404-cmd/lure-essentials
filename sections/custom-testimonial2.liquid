  <script>
    document.addEventListener('DOMContentLoaded', function () {
      const section = document.querySelector('#innersection-{{ section.id }}');

      if (section) {
        section.addEventListener('click', function (event) {
          const playBtn = event.target.closest('.play-button');
          if (!playBtn) return;

          const currentCard = playBtn.closest('.testimonial-card');
          const currentVideo = currentCard.querySelector('video');

          // Pause all other videos and reset SVGs
          section.querySelectorAll('.testimonial-card').forEach(card => {
            const video = card.querySelector('video');
            const svg = card.querySelector('.play-button svg');
            if (video && video !== currentVideo) {
              video.pause();
              if (svg) svg.style.display = 'block';
            }
          });

          // Play or pause current video
          if (currentVideo) {
            const svg = playBtn.querySelector('svg');
            if (currentVideo.paused) {
              currentVideo.play();
              if (svg) svg.style.display = 'none';
            } else {
              currentVideo.pause();
              if (svg) svg.style.display = 'block';
            }
          }
        });
      }
    });
  </script>
  <script src="https://unpkg.com/swiper/swiper-bundle.min.js"></script>
  <script>
