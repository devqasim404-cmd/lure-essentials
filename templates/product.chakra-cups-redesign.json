        "custom_product_accordion_iGN3AG": {
          "type": "custom_product_accordion",
          "settings": {
            "heading": "Product information",
            "content_type": "text",
            "metafield_source": "none",
            "open_by_default": false,
            "step_1_title": "Tear open",
            "step_1_description": "a sealed mask — no prep",
            "step_2_title": "Loop it on",
            "step_2_description": "— ear loops keep it in place",
            "step_3_title": "Feel the cold",
            "step_3_description": "for 60+ minutes",
            "description": "Experience powerful targeted cupping therapy with the CHAKRA vacuum cup set. The unique push-flip design delivers exceptionally strong, precise suction that's easy to control.\n\nYour Professional Set includes 8 cups in 4 different sizes (2 of each size) and a convenient storage/travel bag. These versatile cups excel at targeting trigger points, muscle knots, and joint areas. The variety of sizes ensures optimal coverage and treatment intensity for different body areas, from broad muscle groups to specific pressure points. Particularly effective for hands, wrists, elbows, knees, ankles, and plantar fasciitis, their strong suction makes them ideal for deep tissue work and systematic approaches to pain relief.\n\nDesigned specifically for stationary (\"parked\") cupping, these cups are favored by practitioners treating chronic tension, deep muscle knots, and stubborn adhesions. The enhanced suction power provides deeper therapeutic benefits while releasing stubborn knots and reducing discomfort. Perfect for both clinical settings and self-care at home, these professional-grade cups offer superior results for experienced practitioners and serious self-care enthusiasts."
          }
        },
        "accordion_tabcusto": {
          "type": "custom_product_accordion",
          "settings": {
            "heading": "Materials",
            "content_type": "text",
            "metafield_source": "none",
            "open_by_default": false,
            "step_1_title": "Tear open",
            "step_1_description": "a sealed mask — no prep",
            "step_2_title": "Loop it on",
            "step_2_description": "— ear loops keep it in place",
            "step_3_title": "Feel the cold",
            "step_3_description": "for 60+ minutes",
            "description": "Crafted with our exclusive FlexiPure silicone:\n• Medical-grade, body-safe silicone\n• Free from BPA, BPS, phthalates, PVC, and latex\n• No harmful fillers or additives\n• Iconic transparent design for easy placement and monitoring\n• Durable, easy-to-clean material\n• Professional-grade construction"
          }
        },
        "accordion_0a71f30d": {
          "type": "custom_product_accordion",
          "settings": {
            "heading": "How To Use",
            "content_type": "text",
            "metafield_source": "none",
            "open_by_default": false,
            "step_1_title": "Tear open",
            "step_1_description": "a sealed mask — no prep",
            "step_2_title": "Loop it on",
            "step_2_description": "— ear loops keep it in place",
            "step_3_title": "Feel the cold",
            "step_3_description": "for 60+ minutes",
            "description": "CHAKRA cups are designed exclusively for stationary cupping:\n\nPlace cups on clean, dry skin and leave for 3-5 minutes. The push-flip design allows for easy, single-handed application, making self-treatment simple and effective.\n\nImportant: These cups are designed for stationary use only - do not attempt gliding or sliding movements. Always use on clean skin and avoid lymph nodes. Consult the included cupping guide for complete instructions, professional tips, and contraindications."
          }
        }
