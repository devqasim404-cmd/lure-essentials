        "quote_fC8Ynb": {
          "settings": {
            "author": "~ Tatiana",
            "avatar": "shopify:\/\/shop_images\/R4.jpg",
            "info": "",
            "quote": "As someone who spends hours glued to screens, the Eye Serenity steam eye mask has been a game-changer! After long days of staring at my phone and computer, my eyes feel strained and tired. This mask provides instant relief. The gentle warmth and soothing steam instantly relax and comfort my eyes, melting away the tension. It's like a mini spa treatment for my overworked peepers. My eyes thank me every time!",
            "rate": 5,
