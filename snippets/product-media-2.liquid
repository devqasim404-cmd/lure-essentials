<style>
  #pm-image-lightbox {
    position: fixed !important;
    inset: 0 !important;
    z-index: 2147483647 !important;
    background: rgba(0, 0, 0, 0.97) !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    width: 100vw !important;
    height: 100dvh !important;
    padding: 50px 20px !important;
    box-sizing: border-box !important;
    isolation: isolate !important;
  }

  #pm-image-lightbox[hidden] {
    display: none !important;
  }

  #pm-image-lightbox img {
    position: relative !important;
    z-index: 1 !important;
    display: block !important;
    max-width: 100% !important;
    max-height: 90vh !important;
    width: auto !important;
    height: auto !important;
    object-fit: contain !important;
  }

  #pm-image-lightbox .pm-image-lightbox__close {
    position: absolute !important;
    top: 15px !important;
    right: 20px !important;
    z-index: 2 !important;
    width: 46px !important;
    height: 46px !important;
    padding: 0 !important;
    border: 0 !important;
    border-radius: 50% !important;
    background: white !important;
    color: black !important;
    font-size: 32px !important;
    line-height: 1 !important;
    cursor: pointer !important;
  }
</style>

<div id="pm-image-lightbox" hidden>
  <button type="button"
    class="pm-image-lightbox__close"
    aria-label="Close image">&times;</button>
  <img src="" alt="">
</div>

<script>
(function () {
  const box = document.getElementById('pm-image-lightbox');
  if (!box || box.dataset.initialized) return;
  box.dataset.initialized = 'true';

  // Move overlay directly under body to escape parent stacking contexts.
  document.body.appendChild(box);

  const preview = box.querySelector('img');
  const close = box.querySelector('button');

  function closeImage() {
    box.hidden = true;
    preview.removeAttribute('src');
    document.body.style.overflow = '';
  }

  document.addEventListener('click', function (event) {
    const link = event.target.closest('[data-pm-image-link]');
    if (!link) return;

    event.preventDefault();

    preview.src = link.href;
    preview.alt =
      link.querySelector('img')?.alt || 'Product image';

    box.hidden = false;
    document.body.style.overflow = 'hidden';
  });

  close.addEventListener('click', closeImage);

  box.addEventListener('click', function (event) {
    if (event.target === box) closeImage();
  });

  document.addEventListener('keydown', function (event) {
    if (event.key === 'Escape' && !box.hidden) closeImage();
  });
})();
</script>
