<div class="bundle-header">
  <h2>
    <span>Your Bedtime </span>
    <span class="bundle-highlight">Game Changer Bundle:</span>
  </h2>
</div>
<div id="bundle-section" class="bundle-wrapper">
  <div class="bundle-box">
    <div class="bundle-image-block">
      <img src="{{ block.settings.image | img_url: '400x' }}" class="bundle-main-img">
       <button  type="button"  class="bundle-add-btn mobile" {% if have_productt == true %}disabled{% endif %}  data-bundle-btn>
        Upgrade &amp; Save  {% comment %}{{ bundle_total_price | money }}{% endcomment %}
      </button>
    </div>
    <div class="bundle-info-block">
      <div class="bundle-title">
        {{ block.settings.text }}
      </div>
      <div class="bundle-products">
        {% assign bundle_total_price = 0 %}
        {% assign bundle_total_compare = 0 %}
        {% for addon_product in block.settings.products %}
          {% assign variant = addon_product.selected_or_first_available_variant %}
          {% assign row_price = variant.price | times: 1 %}
          {% assign row_compare = variant.compare_at_price | times: 1 %}
          {% assign bundle_total_price = bundle_total_price | plus: row_price %}
          {% assign bundle_total_compare = bundle_total_compare | plus: row_compare %}
          <div
            class="bundle-product-row"
            data-varient-id="{{ variant.id }}"
            data-parent="{{ product.id }}"
            data-price="{{ row_price }}"
            data-price-compare="{{ row_compare }}"
          >
            {% if addon_product.metafields.custom.bundle_product_title.value != blank %}
             <span class="product-label"> 1 - {{ addon_product.metafields.custom.bundle_product_title.value }} </span>
            {% else %}
             <span class="product-label"> {{ block.settings.desc }} </span>
            {% endif %}
          {% comment %}
          <div class="supply-duration">
            <span class="product-supply">30 Days Supply</span>
            <span class="product-supply">30 Days Supply</span>
          </div>{% endcomment %}
          </div>  
        {% endfor %}
      </div>
      <div class="bundle-price-row">
        <span class="bundle-price" id="bundlePrice">
          {{ bundle_total_price | money }}
        </span>
        {% if bundle_total_compare > 0 %}
          <span class="bundle-compare" id="bundleCompare">
            {{ bundle_total_compare | money }}
          </span>
        {% endif %}
      </div>
      {% assign have_productt = true %}
        {% for item in cart.items %}
          {% assign have_itemmm = item.url | split: '?' | first %}
            {% if have_itemmm == product.url %}
            {% assign have_productt = false %}
            {% endif %}
         {% endfor %}
       <button
  type="button"
  class="bundle-add-btn desktop"
  data-bundle-btn
  {% if have_productt == true %}disabled{% endif %}
>
  Upgrade &amp; Save
</button>


    </div>
  </div>
</div>

<script>
  async function fetchCartAndToggleBundleButton(productUrlToCheck) {
    try {
      const response = await fetch('/cart.js');
      const cart = await response.json();
      const bundleAddBtns = document.querySelectorAll('[data-bundle-btn]');
      let productInCart = false;

      cart.items.forEach(item => {
        const baseUrl = item.url.split('?')[0];
        if (baseUrl === productUrlToCheck) {
          productInCart = true;
        }
      });

      bundleAddBtns.forEach(btn => {
        if (productInCart) {
          btn.removeAttribute('disabled');
        } else {
          btn.setAttribute('disabled', 'disabled');
        }
      });
    } catch (err) {
      console.error('Failed to fetch cart', err);
    }
  }

  document.addEventListener('DOMContentLoaded', function () {
    const productUrlToCheck = window.location.pathname;

    // Initial check on page load
    fetchCartAndToggleBundleButton(productUrlToCheck);

    // On add to cart
    document.body.addEventListener('click', function (e) {
      if (e.target.closest('.product-form__cart-submit')) {
        setTimeout(() => {
          fetchCartAndToggleBundleButton(productUrlToCheck);
        }, 1000);
      }
    });

    // On remove from cart
    document.body.addEventListener('click', function (e) {
      if (e.target.closest('.remove-all-matching')) {
        setTimeout(() => {
          fetchCartAndToggleBundleButton(productUrlToCheck);
        }, 1000);
      }
    });
  });
</script>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    // Initialize cart drawer if not already initialized
    if (!window.cartDrawerInstance) {
      window.cartDrawerInstance = new theme.Drawers('CartDrawer', 'right', {
        onDrawerOpen: function () {
          console.log('[Drawer] Cart drawer opened');
        },
        onDrawerClose: function () {
          console.log('[Drawer] Cart drawer closed');
        }
      });
    }

    document.querySelectorAll('[data-bundle-btn]').forEach(btn => {
      btn.addEventListener('click', async function () {
        const currentBtn = this;
        currentBtn.disabled = true;
        currentBtn.textContent = "Adding...";

        const variantRows = document.querySelectorAll('.bundle-product-row');
        const variantData = [];

        variantRows.forEach(row => {
          const variantId = row.dataset.variantId || row.dataset.varientId;
          const parent = row.dataset.parent || '';
          if (variantId) {
            variantData.push({ variantId, parent });
          }
        });

        for (let item of variantData) {
          console.log(`Adding variant ${item.variantId} with _free_with = ${item.parent}`);

          try {
            const res = await fetch('/cart/add.js', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json'
              },
              body: JSON.stringify({
                id: item.variantId,
                quantity: 1,
                properties: {
                  '_free_with': item.parent
                }
              })
            });

            if (!res.ok) throw new Error('Add to cart failed');
            await res.json();

          } catch (err) {
            console.error('[Cart Add Error]', err.message || err);
            currentBtn.textContent = "Error, Try Again";
            currentBtn.disabled = false;
            alert('Error adding to cart. Please refresh and try again.');
            return;
          }
        }

        // Update cart UI
        if (window.theme?.miniCart?.updateElements) {
          theme.miniCart.updateElements();
          theme.miniCart.generateCart?.();
        }

        // Open cart drawer
        if (window.cartDrawerInstance?.open) {
          window.cartDrawerInstance.open();
        } else if (window.theme?.miniCart?.open) {
          theme.miniCart.open();
        }

        // Reset button state
        currentBtn.textContent = "Added!";
        setTimeout(() => {
          currentBtn.textContent = "Upgrade & Save";
          currentBtn.disabled = false;
        }, 2000);
      });
    });

    // Handle unhandled subscription widget errors silently
    window.addEventListener("unhandledrejection", function (event) {
      const msg = event.reason?.message || event.reason;
      if (String(msg).includes("subscription")) {
        console.warn("[Subscription Widget Error Ignored]", msg);
        event.preventDefault();
      }
    });
  });
</script>




