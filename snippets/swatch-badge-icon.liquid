{%- comment -%}
  Icon for a swatch badge, chosen by the handleized badge_style value.
  Usage: {% render 'swatch-badge-icon', style: 'bestseller' %}
  Styles without an icon render nothing.
{%- endcomment -%}
{%- case style -%}
  {%- when 'bestseller', 'best-seller' -%}
    <svg class="swatch-badge-icon" viewBox="0 0 24 24" width="10" height="10" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 2.5l2.94 5.96 6.56.95-4.75 4.63 1.12 6.54L12 17.5l-5.87 3.08 1.12-6.54L2.5 9.41l6.56-.95z"/></svg>
  {%- when 'favorite', 'favourite' -%}
    <svg class="swatch-badge-icon" viewBox="0 0 24 24" width="10" height="10" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 21s-7.4-4.5-9.5-9.1C1.1 8.6 3.1 5 6.6 5c2 0 3.5 1.1 4.4 2.5C11.9 6.1 13.4 5 15.4 5c3.5 0 5.5 3.6 4.1 6.9C19.4 16.5 12 21 12 21z"/></svg>
{%- endcase -%}
