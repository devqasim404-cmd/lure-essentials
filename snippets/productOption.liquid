<!-- productOption.liquid -->

{%- if product_selector == 'radio' -%}
  {%- liquid
    assign isColor = false
    assign optionName = option.name | handleize
    assign option_index = loop
  -%}
  {%- if optionName contains 'colo' -%}
    {%- assign isColor = true -%}
  {%- endif -%}
  <fieldset
    class="single-option-radio {% if isColor %} single-color {{ size_color }} {% if color_circle %}round-color {% else %} square-color {% endif %} {% endif %} "
    name="{{ option.name | handleize }}"
    id="ProductSelect-option-{{ optionName }}-{{ forloop.index0 }}"
  >
    {%- for value in option.values -%}
      {%- liquid
        assign variant_label_state = true
        if product.options.size == 1
          unless product.variants[forloop.index0].available
            assign variant_label_state = false
          endunless
        endif
        for variant in product.variants
          assign vOption = 'option' | append: option_index
          if value == variant[vOption]
            assign currenVariant = variant
            break
          endif
        endfor
        assign hasImage = false
        if isColor and currenVariant.image
          assign hasImage = true
        endif
      -%}
      <div class="varient_div">
        {% assign gift_names = '' %}
        {% assign testimonialsteps = currenVariant.metafields.custom.select_gift.value %}
        {% for step in testimonialsteps %}
          {% assign gift_names = gift_names | append: step.gift_name %}
          {% unless forloop.index == default_option_value %}
            {% assign gift_names = gift_names | append: ', ' %}
          {% endunless %}
        {% endfor %}

        {% assign default_option_value = product.metafields.custom.default_option | plus: 0 %}
        <input
          type="radio"
          {% if forloop.index == default_option_value -%}
            checked="checked"
          {%- endif %}
          {% unless variant_label_state -%}
            disabled="disabled"
          {%- endunless %}
          value="{{ value | escape }}"
          data-index="option{{ option_index }}"
          data-varient="option{{ currenVariant.id }}"
          data-varient-price="{{ currenVariant.price | money_without_currency}}"
          data-varient-name="{{ value | remove: ' + free gifts on 1st order' |  escape }}"
          data-strenth="{{ currenVariant.metafields.custom.supply_duration }}"
          data-image="{{ currenVariant.metafields.custom.variant_swatch_image | img_url: 'master' }}"
          data-varient-gift="{{ gift_names }}"
          name="{{ option.name | handleize }}"
          class="single-option-selector-{{ section.id }} single-option-selector__radio{% unless variant_label_state %} disabled{% endunless %}"
          id="ProductSelect-option-{{ option.name | handleize }}-{{ value | escape }}"
        >
        <label
          {% if hasImage %}
            title="{{ value | escape }}"
            {%- if sw_color_product -%}
              class="st-color-{{ value | escape | handle }}"
              style="background-color:{{ value | escape | handle }};"
            {% else %}
              style="background-image:url({{ currenVariant.image.src | image_url: width: 100 }})"
            {% endif -%}
          {% endif %}
          for="ProductSelect-option-{{ option.name | handleize }}-{{ value | escape }}"
          {% unless variant_label_state %}
            class="disabled"
          {% endunless %}
        >
          {% if value == '2 Pack - 30 Eye Masks + free gifts on 1st order' or value == '2 Pack - 40 Foot Pads' %}
            <span class="label-tag">Best Seller</span>
          {% endif %}
          {% if value == '3 Pack - 45 Eye Masks + free gifts on 1st order' or value == '3 Pack - 60 Foot Pads' %}
            <span class="label-tag tag2">Best Value</span>
          {% endif %}
          <div class="variant-image-wrapper">
            {% if currenVariant.metafields.custom.variant_swatch_image != blank %}
              <img
                src="{{ currenVariant.metafields.custom.variant_swatch_image | img_url: 'master' }}"
                class="varient_image"
              >
            {% endif %}
          </div>
          <div class="varient_content">
          <span class="variation-name">{%- unless hasImage -%}{{ value | remove: ' + free gifts on 1st order' | escape }}{%- endunless -%}</span>
          <span class="varient_metafield">{{ currenVariant.metafields.custom.supply_duration }}</span>

          {% comment %}
          <span class="variant-price">
            {{ currenVariant.price | money_without_trailing_zeros}}
          </span>
          {% endcomment %}


          <span class="variant-prices">
            <span class="current-price">
              {{ currenVariant.price | money }}
            </span>

            {% if currenVariant.compare_at_price > currenVariant.price %}
              <span class="compare-price" style="text-decoration: line-through; margin-left: 8px;">
                {{ currenVariant.compare_at_price | money }}
              </span>
            {% endif %}
          </span>

          {% if currenVariant.compare_at_price > currenVariant.price %}
            {% assign discount_amount = currenVariant.compare_at_price | minus: currenVariant.price %}
            {% assign discount_percent = discount_amount | times: 100 | divided_by: currenVariant.compare_at_price %}

            <div class="you-save">
              You Save {{ discount_percent }}% ({{ discount_amount | money }})
            </div>
          {% endif %}



        </div>
      </label>
    </div>
  {%- endfor -%}
</fieldset>
{%- else -%}
  <select
    class="single-option-selector single-option-selector-{{ section.id }} product-form__input"
    id="SingleOptionSelector-{{ forloop.index0 }}"
    data-name="{{ option.name }}"
    data-index="option{{ loop }}"
  >
    {%- for value in option.values -%}
      <option
        value="{{ value | escape }}"
        {% if option.selected_value == value %}
          selected="selected"
        {% endif %}
      >
        {{ value }}
      </option>
    {%- endfor -%}
  </select>
{%- endif -%}
