{%- if section.settings.enable -%}
  {%- assign current_variant = product.selected_or_first_available_variant -%}
  {%- assign sticky_image = product.featured_image -%}
  {%- assign first_plan_group = product.selling_plan_groups | first -%}
  {%- assign first_plan = first_plan_group.selling_plans | first -%}
  {%- assign first_adjustment = first_plan.price_adjustments | first -%}

  <style>
    :root {
      --sticky-cart-bg: #ffffff;
      --sticky-cart-navy: #141a5c;
      --sticky-cart-muted: #4a5170;
      --sticky-cart-border: #e6e9f0;
      --sticky-cart-surface: #f1f4f9;
      --sticky-cart-orange: #e89a0c;
      --sticky-cart-height: 0px;
    }

    .template-product {
      padding-bottom: 0 !important;
    }

    .sticky-cart-wr {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 99999;
      width: 100%;
      box-sizing: border-box;
      padding: 12px 0;
      background: rgba(255, 255, 255, 0.98);
      border-top: 1px solid var(--sticky-cart-border);
      box-shadow: 0 -4px 20px rgba(20, 26, 92, 0.09);
      transform: translateY(calc(100% + 20px));
      transition: transform 0.3s ease;
      visibility: hidden;
      pointer-events: none;
    }

    .sticky-cart-wr.active {
      transform: translateY(0);
      visibility: visible;
      pointer-events: auto;
    }

    .sticky-cart-wr.disable {
      transform: translateY(calc(100% + 20px)) !important;
      visibility: hidden;
      pointer-events: none;
    }

    .sticky-cart-inner {
      width: 100%;
      max-width: 100%;
      margin: 0 auto;
      padding: 0 60px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      box-sizing: border-box;
      min-width: 0;
    }

    .sticky-cart-product {
      display: flex;
      align-items: center;
      gap: 12px;
      flex: 1 1 240px;
      min-width: 0;
    }

    #js-sticky-img {
      display: block;
      width: 54px;
      height: 54px;
      flex: 0 0 54px;
      object-fit: cover;
      border: 1px solid var(--sticky-cart-border);
      border-radius: 12px;
      box-sizing: border-box;
    }

    .sticky-cart-product-info {
      display: flex;
      flex-direction: column;
      gap: 4px;
      min-width: 0;
    }

    #js-sticky-prd h3 {
      margin: 0;
      padding: 0;
      max-width: 310px;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      color: var(--sticky-cart-navy);
      font-family: Poppins, var(--g-font-family, sans-serif);
      font-size: 15px;
      line-height: 1.4;
      font-weight: 600;
      letter-spacing: 0;
      text-transform: none;
    }

    #js-sticky-title {
      font-weight: 400;
    }

    .sticky-cart-rating {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 5px;
      color: var(--sticky-cart-muted);
      font-size: 12px;
      line-height: 1.4;
    }

    .sticky-cart-stars {
      color: var(--sticky-cart-orange);
      font-size: 14px;
      letter-spacing: 0;
      white-space: nowrap;
    }

    .sticky-cart-rating strong {
      color: var(--sticky-cart-navy);
      font-weight: 700;
    }

    .sticky-cart-rating a {
      color: inherit;
      text-decoration: none;
    }

    .sticky-cart-selectors {
      display: flex;
      align-items: center;
      gap: 16px;
      flex: 0 1 auto;
      min-width: 0;
    }

    .sticky-cart-option {
      display: flex;
      align-items: center;
      gap: 2px;
      padding: 4px;
      border-radius: 999px;
      background: var(--sticky-cart-surface);
      min-width: 0;
    }

    .sticky-cart-option-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 38px;
      padding: 0 14px;
      border: 0;
      border-radius: 999px;
      background: transparent;
      color: var(--sticky-cart-muted);
      font: inherit;
      font-size: 13px;
      font-weight: 500;
      line-height: 1.2;
      white-space: nowrap;
      cursor: pointer;
      transition: background 0.15s ease, color 0.15s ease;
    }

    .sticky-cart-option-button[aria-pressed="true"] {
      background: #fff;
      color: var(--sticky-cart-navy);
      box-shadow: 0 1px 4px rgba(20, 26, 92, 0.18);
      font-weight: 600;
    }

    .sticky-cart-option-button:focus-visible,
    .sticky-cart-subscribe:focus-visible,
    #js-sticky-btn:focus-visible {
      outline: 2px solid #5368d5;
      outline-offset: 3px;
    }

    .sticky-cart-selectors select {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    .sticky-cart-subscribe {
      display: inline-flex;
      align-items: center;
      gap: 9px;
      flex: 0 0 auto;
      padding: 6px 0;
      border: 0;
      background: transparent;
      color: var(--sticky-cart-navy);
      font: inherit;
      font-size: 12px;
      font-weight: 600;
      white-space: nowrap;
      cursor: pointer;
    }

    .sticky-cart-switch {
      position: relative;
      display: inline-block;
      width: 40px;
      height: 24px;
      flex: 0 0 40px;
      border-radius: 999px;
      background: #b9bfd0;
      transition: background 0.2s ease;
    }

    .sticky-cart-switch::after {
      content: "";
      position: absolute;
      top: 3px;
      left: 3px;
      width: 18px;
      height: 18px;
      border-radius: 50%;
      background: #fff;
      box-shadow: 0 1px 3px rgba(20, 26, 92, 0.25);
      transition: transform 0.2s ease;
    }

    .sticky-cart-subscribe[aria-checked="true"] .sticky-cart-switch {
      background: var(--sticky-cart-navy);
    }

    .sticky-cart-subscribe[aria-checked="true"] .sticky-cart-switch::after {
      transform: translateX(16px);
    }

    .sticky-cart-purchase {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 16px;
      flex: 0 0 auto;
      margin-left: auto;
    }

    .sticky-cart-price-wrap {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 2px;
      min-width: 95px;
    }

    .sticky-cart-price-line {
      display: flex;
      align-items: baseline;
      justify-content: flex-end;
      gap: 8px;
      color: var(--sticky-cart-navy);
      white-space: nowrap;
    }

    #js-sticky-compare {
      color: #6b7190;
      font-size: 13px;
    }

    #js-sticky-price {
      color: var(--sticky-cart-navy);
      font-family: Poppins, var(--g-font-family, sans-serif);
      font-size: 20px;
      line-height: 1.2;
      font-weight: 700;
    }

    #js-sticky-savings {
      color: #a13a0b;
      font-size: 11.5px;
      font-weight: 700;
      text-align: right;
      white-space: nowrap;
    }

    #js-sticky-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 142px;
      min-height: 50px;
      margin: 0;
      padding: 0 26px;
      border: 0;
      border-radius: 14px;
      background: var(--sticky-cart-navy);
      color: #fff;
      font-family: Poppins, var(--g-font-family, sans-serif);
      font-size: 15px;
      font-weight: 600;
      line-height: 1.2;
      white-space: nowrap;
      box-shadow: 0 8px 20px rgba(20, 26, 92, 0.20);
      cursor: pointer;
      transition: background 0.2s ease, opacity 0.2s ease;
      letter-spacing: normal;
    text-transform: capitalize;
    }

    #js-sticky-btn:hover {
      background: #202878;
      color: #fff;
    }

    #js-sticky-btn:disabled {
      opacity: 0.55;
      cursor: not-allowed;
    }

    #js-sticky-close {
      display: none;
    }

    @media (min-width: 541px) and (max-width: 1100px) {
      .sticky-cart-inner {
        gap: 12px;
        padding: 0 16px;
      }

      .sticky-cart-product {
        flex: 1 1 190px;
        gap: 8px;
      }

      #js-sticky-img {
        width: 44px;
        height: 44px;
        flex-basis: 44px;
      }

      #js-sticky-prd h3 {
        max-width: 210px;
        font-size: 12px;
      }

      .sticky-cart-selectors {
        gap: 8px;
      }

      .sticky-cart-option-button {
        min-height: 34px;
        padding: 0 9px;
        font-size: 11px;
      }

      .sticky-cart-subscribe {
        gap: 6px;
        font-size: 11px;
      }

      .sticky-cart-purchase {
        gap: 10px;
      }

      #js-sticky-price {
        font-size: 18px;
      }

      #js-sticky-btn {
        min-width: 112px;
        min-height: 46px;
        padding: 0 16px;
        font-size: 13px;
      }
    }

    @media (max-width: 760px) {
      .sticky-cart-inner {
        gap: 10px;
        padding: 0 12px;
      }

      .sticky-cart-product {
        flex: 1 1 140px;
        gap: 8px;
      }

      #js-sticky-img {
        width: 42px;
        height: 42px;
        flex-basis: 42px;
        border-radius: 8px;
      }

      #js-sticky-prd h3 {
        max-width: 180px;
        font-size: 12px;
      }

      .sticky-cart-rating {
        font-size: 10px;
        gap: 3px;
      }

      .sticky-cart-selectors {
        flex: 0 1 auto;
        gap: 6px;
      }

      .sticky-cart-option-button {
        min-height: 32px;
        padding: 0 9px;
        font-size: 11px;
      }

      .sticky-cart-subscribe {
        font-size: 0;
        gap: 0;
      }

      .sticky-cart-subscribe .sticky-cart-switch {
        font-size: 12px;
      }

      .sticky-cart-purchase {
        gap: 8px;
      }

      .sticky-cart-price-wrap {
        min-width: 0;
      }

      #js-sticky-price {
        font-size: 17px;
      }

      #js-sticky-compare {
        font-size: 12px;
      }

      #js-sticky-savings {
        display: none;
      }

      #js-sticky-btn {
        min-width: 100px;
        min-height: 44px;
        padding: 0 13px;
        border-radius: 10px;
        font-size: 12px;
      }
    }

    @media (max-width: 540px) {
      .sticky-cart-wr {
        padding: 8px 0 calc(8px + env(safe-area-inset-bottom));
        border-radius: 20px 20px 0 0;
        box-shadow: 0 -6px 24px rgba(20, 26, 92, 0.12);
      }

      .sticky-cart-inner {
        display: grid;
        grid-template-columns: 48px minmax(0, 1fr) 120px;
        grid-template-rows: 32px 22px;
        align-items: center;
        gap: 2px 8px;
        padding: 0 12px;
      }

      /* Mobile layout: image, price and button on the first row. */
      .sticky-cart-product {
        display: contents;
      }

      #js-sticky-img {
        grid-column: 1;
        grid-row: 1 / 3;
        align-self: center;
        width: 48px;
        height: 48px;
        flex: none;
        border-radius: 9px;
      }

      .sticky-cart-product-info {
        display: none;
      }

      .sticky-cart-purchase {
        display: contents;
      }

      .sticky-cart-price-wrap {
        grid-column: 2;
        grid-row: 1;
        align-self: end;
        justify-self: start;
        align-items: flex-start;
        min-width: 0;
        max-width: 100%;
        gap: 0;
      }

      .sticky-cart-price-line {
        justify-content: flex-start;
        align-items: baseline;
        gap: 6px;
        flex-direction: row-reverse;
      }

      #js-sticky-price {
        font-size: 17px;
        line-height: 1.15;
        font-weight: 700;
      }

      #js-sticky-compare {
        font-size: 12px;
        line-height: 1.15;
      }

      #js-sticky-savings {
        display: none;
      }

      #js-sticky-btn {
        grid-column: 3;
        grid-row: 1 / 3;
        justify-self: stretch;
        align-self: center;
        width: 100%;
        min-width: 0;
        min-height: 44px;
        padding: 0 10px;
        border-radius: 15px;
        font-size: 13px;
        font-weight: 600;
        white-space: nowrap;
      }

      /* Compact variant and subscription line, like the reference image. */
      .sticky-cart-selectors {
        display: flex;
        grid-column: 2;
        grid-row: 2;
        align-self: start;
        justify-self: start;
        width: 58%;
        max-width: 58%;
        min-width: 0;
        overflow: visible;
        gap: 0;
      }

      .sticky-cart-option {
        display: flex;
        align-items: center;
        min-width: 0;
        max-width: 100%;
        padding: 0;
        gap: 0;
        background: transparent;
        border-radius: 0;
      }

      .sticky-cart-option-button {
        display: none;
        min-height: 20px;
        padding: 0;
        border: 0;
        border-radius: 0;
        background: transparent;
        box-shadow: none;
        color: var(--sticky-cart-navy);
        font-size: 11px;
        font-weight: 500;
        line-height: 1.2;
        white-space: nowrap;
      }

      .sticky-cart-option-button[aria-pressed="true"] {
        display: none;
        max-width: 100%;
        overflow: hidden;
        text-overflow: ellipsis;
        background: transparent;
        box-shadow: none;
        color: var(--sticky-cart-navy);
        font-weight: 600;
      }

      .sticky-cart-option-button[aria-pressed="true"]::after {
        content: "⌃";
        margin-left: 5px;
        font-size: 12px;
        line-height: 1;
      }

      #js-sticky-cart.sticky-options-expanded .sticky-cart-option-button {
        display: inline-flex;
        padding: 0 7px;
        background: #fff;
        border-radius: 6px;
        box-shadow: 0 1px 4px rgba(20, 26, 92, 0.12);
      }

      #js-sticky-cart.sticky-options-expanded .sticky-cart-option-button[aria-pressed="true"] {
        background: var(--sticky-cart-surface);
      }

      #js-sticky-cart.sticky-options-expanded .sticky-cart-selectors {
        z-index: 2;
        width: max-content;
        max-width: calc(100vw - 170px);
        overflow-x: auto;
        background: #fff;
        border-radius: 8px;
        box-shadow: 0 2px 10px rgba(20, 26, 92, 0.12);
      }

      #js-sticky-cart.sticky-options-expanded .sticky-cart-option {
        flex-wrap: wrap;
      }

      .sticky-cart-subscribe {
        display: inline-flex;
        grid-column: 2;
        grid-row: 2;
        align-self: start;
        justify-self: end;
        width: 42%;
        max-width: 42%;
        min-width: 0;
        padding: 0;
        gap: 0;
        color: var(--sticky-cart-navy);
        font-size: 11px;
        font-weight: 500;
        line-height: 20px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      .sticky-cart-switch {
        display: none;
      }

      .sticky-cart-subscribe::after {
        content: "⌃";
        margin-left: 4px;
        font-size: 12px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .sticky-cart-wr,
      .sticky-cart-switch,
      .sticky-cart-switch::after {
        transition: none;
      }
    }
  </style>

  <div id="js-anchor-sticky-cart"></div>

  <div
    class="sticky-cart-wr"
    id="js-sticky-cart"
    data-product-id="{{ product.id }}"
    data-current-variant="{{ current_variant.id }}"
  >
    <div class="sticky-cart-inner" id="js-sticky-prd">

      <div class="sticky-cart-product">
        {%- if sticky_image != blank -%}
          <img
            id="js-sticky-img"
            src="{{ sticky_image | image_url: width: 104 }}"
            alt="{{ sticky_image.alt | default: product.title | escape }}"
            width="52"
            height="52"
            loading="lazy"
          >
        {%- endif -%}

        <div class="sticky-cart-product-info">
          <h3>
            {{ product.title | escape }}
            <span id="js-sticky-title">
              {%- unless product.has_only_default_variant -%}
                — {{ current_variant.title | escape }}
              {%- endunless -%}
            </span>
          </h3>

          <div class="sticky-cart-rating">
            {%- if product.metafields.reviews.rating.value.rating != blank -%}
              <span class="sticky-cart-stars" aria-label="Product rating">
                ★★★★★
              </span>
              <strong>
                {{ product.metafields.reviews.rating.value.rating | round: 1 }}
              </strong>

              {%- if product.metafields.reviews.rating_count != blank -%}
                <span>
                  ({{ product.metafields.reviews.rating_count }})
                </span>
              {%- endif -%}

              <span aria-hidden="true">·</span>
            {%- endif -%}

            <span id="js-sticky-variant-caption">
              {{ current_variant.title | default: 'Original' | escape }}
            </span>
          </div>
        </div>
      </div>


      <div class="sticky-cart-purchase">
        <div class="sticky-cart-price-wrap">
          <div class="sticky-cart-price-line">
            <s id="js-sticky-compare"
              {% unless current_variant.compare_at_price > current_variant.price %}
                hidden
              {% endunless %}
            >
              {{ current_variant.compare_at_price | money }}
            </s>

            <span id="js-sticky-price">
              {{ current_variant.price | money }}
            </span>
          </div>

          <span id="js-sticky-savings"
            {% unless current_variant.compare_at_price > current_variant.price %}
              hidden
            {% endunless %}
          >
            {%- if current_variant.compare_at_price > current_variant.price -%}
              You save
              {{ current_variant.compare_at_price | minus: current_variant.price | money }}
            {%- endif -%}
          </span>
        </div>

        <button
          type="button"
          id="js-sticky-btn"
          class="btn btn-theme"
          data-buttonid="AddToCart-{{ section.id }}"
          {% unless current_variant.available %}disabled{% endunless %}
        >
          {%- if current_variant.available -%}
            {{ 'products.product.add_to_cart' | t }}
          {%- else -%}
            {{ 'products.product.sold_out' | t }}
          {%- endif -%}
        </button>
      </div>

    </div>
  </div>

  <script type="application/json" id="js-sticky-variants-{{ section.id }}">
    {{ product.variants | json }}
  </script>

  <script>
    (function () {
      var sticky = document.getElementById('js-sticky-cart');
      var stickyButton = document.getElementById('js-sticky-btn');

      if (!sticky || !stickyButton || sticky.dataset.initialized === 'true') {
        return;
      }

      sticky.dataset.initialized = 'true';

      var variantsElement = document.getElementById(
        'js-sticky-variants-{{ section.id }}'
      );

      var variants = [];

      try {
        variants = JSON.parse(variantsElement.textContent || '[]');
      } catch (error) {
        console.error('Unable to read product variants.', error);
      }

      var activeVariantId = String(sticky.dataset.currentVariant || '');
      var subscribeButton = document.getElementById('js-sticky-subscribe');
      var selectedPlanId = subscribeButton
        ? String(subscribeButton.dataset.planId || '')
        : '';

      function getMoney(cents) {
        if (
          window.Shopify &&
          typeof window.Shopify.formatMoney === 'function'
        ) {
          return window.Shopify.formatMoney(
            cents,
            {{ shop.money_format | json }}
          );
        }

        return (cents / 100).toLocaleString(
          document.documentElement.lang || 'en',
          {
            style: 'currency',
            currency: {{ cart.currency.iso_code | default: shop.currency | json }}
          }
        );
      }

      function getSelectedOptions() {
        var selected = [];

        sticky.querySelectorAll('.sticky-cart-selectors select').forEach(
          function (select) {
            selected[Number(select.dataset.optionIndex)] = select.value;
          }
        );

        return selected;
      }

      function findSelectedVariant() {
        var selectedOptions = getSelectedOptions();

        return variants.find(function (variant) {
          return variant.options.every(function (option, index) {
            return selectedOptions[index] === option;
          });
        });
      }

      /*
       * PRICE SOURCE PRIORITY
       * 1. If an Appstle bundle or subscription is selected, copy the
       *    calculated price from .custom-product-price.
       * 2. If neither is selected/available, use the selected Shopify variant.
       */
      var customPriceCard = document.querySelector(
        '.custom-product-price[id^="CustomProductPrice-"]'
      );

      var customPriceObserver = null;
      var appstleSyncTimer = null;

      function getCustomPriceElements() {
        customPriceCard = document.querySelector(
          '.custom-product-price[id^="CustomProductPrice-"]'
        );

        if (!customPriceCard) return null;

        return {
          current: customPriceCard.querySelector('[data-current-price]'),
          original: customPriceCard.querySelector('[data-original-price]'),
          savings: customPriceCard.querySelector('[data-savings-amount]')
        };
      }

      function hasAppstleSelection() {
        var selectedBundle = document.querySelector(
          '.ab-volume-discount-item-selected-v2'
        );

        var selectedSubscription = document.querySelector(
          '.appstle_subscription_wrapper input[name="selling_plan"]:checked'
        );

        return Boolean(selectedBundle || selectedSubscription);
      }

      function updateStickyVariantPrice(variant) {
        if (!variant) return;

        var price = document.getElementById('js-sticky-price');
        var compare = document.getElementById('js-sticky-compare');
        var savings = document.getElementById('js-sticky-savings');

        if (price) {
          price.textContent = getMoney(variant.price);
        }

        var hasComparePrice =
          Number(variant.compare_at_price) > Number(variant.price);

        if (compare) {
          compare.hidden = !hasComparePrice;

          if (hasComparePrice) {
            compare.textContent = getMoney(variant.compare_at_price);
          }
        }

        if (savings) {
          savings.hidden = !hasComparePrice;
          savings.textContent = hasComparePrice
            ? 'You save ' + getMoney(
                variant.compare_at_price - variant.price
              )
            : '';
        }
      }

      function syncStickyAppstlePrice() {
        if (!hasAppstleSelection()) return false;

        var elements = getCustomPriceElements();

        if (!elements || !elements.current || !elements.original) {
          return false;
        }

        var stickyPrice = document.getElementById('js-sticky-price');
        var stickyCompare = document.getElementById('js-sticky-compare');
        var stickySavings = document.getElementById('js-sticky-savings');

        if (!stickyPrice || !stickyCompare || !stickySavings) {
          return false;
        }

        var currentText = elements.current.textContent.trim();
        var originalText = elements.original.textContent.trim();

        if (!currentText) return false;

        // Copy the exact formatted prices produced by the existing Appstle
        // custom-price script. Do not calculate the price again here.
        if (stickyPrice.textContent.trim() !== currentText) {
          stickyPrice.textContent = currentText;
        }

        // data-no-discount: non-discounted bundle, so show no compare price or "You save".
        var originalIsVisible =
          elements.original.style.display !== 'none' &&
          originalText !== '' &&
          !elements.original.hasAttribute('data-no-discount');

        stickyCompare.hidden = !originalIsVisible;

        if (originalIsVisible) {
          if (stickyCompare.textContent.trim() !== originalText) {
            stickyCompare.textContent = originalText;
          }
        }

        var savingsText = elements.savings
          ? elements.savings.textContent.trim()
          : '';

        var hasSavings = originalIsVisible && savingsText !== '';

        stickySavings.hidden = !hasSavings;

        var formattedSavings = hasSavings
          ? 'You save ' + savingsText
          : '';

        if (stickySavings.textContent.trim() !== formattedSavings) {
          stickySavings.textContent = formattedSavings;
        }

        return true;
      }

      function syncStickyPrice() {
        if (hasAppstleSelection()) {
          syncStickyAppstlePrice();
          return;
        }

        // No Appstle bundle/subscription selected: restore Shopify variant price.
        var currentVariant = variants.find(function (variant) {
          return String(variant.id) === String(activeVariantId);
        });

        if (currentVariant) {
          updateStickyVariantPrice(currentVariant);
        }
      }

      function scheduleStickyPriceSync() {
        window.clearTimeout(appstleSyncTimer);

        appstleSyncTimer = window.setTimeout(function () {
          syncStickyPrice();
        }, 200);
      }

      function attachCustomPriceObserver() {
        var latestCard = document.querySelector(
          '.custom-product-price[id^="CustomProductPrice-"]'
        );

        if (!latestCard) return;

        if (latestCard === customPriceCard && customPriceObserver) return;

        if (customPriceObserver) {
          customPriceObserver.disconnect();
        }

        customPriceCard = latestCard;
        customPriceObserver = new MutationObserver(
          scheduleStickyPriceSync
        );

        customPriceObserver.observe(customPriceCard, {
          subtree: true,
          childList: true,
          characterData: true,
          attributes: true,
          attributeFilter: ['style', 'class']
        });

        scheduleStickyPriceSync();
      }

      // Appstle bundle, subscription, and delivery-frequency interactions.
      document.addEventListener('click', scheduleStickyPriceSync);
      document.addEventListener('change', scheduleStickyPriceSync);

      // Attach when the custom price block loads or is replaced dynamically.
      var customPriceBlockObserver = new MutationObserver(function () {
        attachCustomPriceObserver();
      });

      if (document.body) {
        customPriceBlockObserver.observe(document.body, {
          subtree: true,
          childList: true
        });
      }

      attachCustomPriceObserver();

      function updateVariantDisplay(variant) {
        if (!variant) return;

        activeVariantId = String(variant.id);
        sticky.dataset.currentVariant = activeVariantId;

        var price = document.getElementById('js-sticky-price');
        var compare = document.getElementById('js-sticky-compare');
        var savings = document.getElementById('js-sticky-savings');
        var title = document.getElementById('js-sticky-title');
        var caption = document.getElementById('js-sticky-variant-caption');

        // Appstle price takes priority when a bundle/subscription is selected.
        // Otherwise use the selected Shopify variant price.
        if (!hasAppstleSelection()) {
          updateStickyVariantPrice(variant);
        } else {
          scheduleStickyPriceSync();
        }

        if (title) {
          title.textContent = variant.options.length > 1 ||
            (variant.options.length === 1 &&
              variant.options[0] !== 'Default Title')
            ? ' — ' + variant.title
            : '';
        }

        if (caption) {
          caption.textContent = variant.title === 'Default Title'
            ? 'Original'
            : variant.title;
        }

        stickyButton.disabled = !variant.available;

        stickyButton.textContent = variant.available
          ? {{ 'products.product.add_to_cart' | t | json }}
          : {{ 'products.product.sold_out' | t | json }};
      }

      function syncOptionButtons(select) {
        var group = select.closest('.sticky-cart-option');

        if (!group) return;

        group.querySelectorAll('[data-sticky-option-button]').forEach(
          function (button) {
            var selected =
              Number(button.dataset.valueIndex) === select.selectedIndex;

            button.setAttribute('aria-pressed', String(selected));
          }
        );
      }

      function syncOriginalProductOption(select) {
        var radioContainer = document.getElementById(
          select.dataset.radio
        );

        var originalSelect = document.getElementById(
          select.dataset.selectbox
        );

        if (radioContainer) {
          var radios = radioContainer.querySelectorAll('input');

          if (radios[select.selectedIndex]) {
            radios[select.selectedIndex].click();
          }
        } else if (originalSelect) {
          originalSelect.value = select.value;

          originalSelect.dispatchEvent(
            new Event('change', { bubbles: true })
          );
        }
      }

      sticky.querySelectorAll('.sticky-cart-selectors select').forEach(
        function (select) {
          syncOptionButtons(select);

          select.addEventListener('change', function () {
            syncOptionButtons(select);
            syncOriginalProductOption(select);

            var variant = findSelectedVariant();

            if (variant) {
              updateVariantDisplay(variant);
            }
          });
        }
      );

      sticky.querySelectorAll('[data-sticky-option-button]').forEach(
        function (button) {
          button.addEventListener('click', function () {
            var select = document.getElementById(button.dataset.selectId);

            if (!select) return;

            select.selectedIndex = Number(button.dataset.valueIndex);

            select.dispatchEvent(
              new Event('change', { bubbles: true })
            );
          });
        }
      );

      // On mobile, tap the selected option to expand/collapse pack choices.
      sticky.querySelectorAll('[data-sticky-option-button]').forEach(
        function (button) {
          button.addEventListener('click', function () {
            if (
              window.matchMedia('(max-width: 540px)').matches &&
              button.getAttribute('aria-pressed') === 'true'
            ) {
              sticky.classList.toggle('sticky-options-expanded');
            }
          });
        }
      );

      document.addEventListener('click', function (event) {
        if (
          window.matchMedia('(max-width: 540px)').matches &&
          !sticky.contains(event.target)
        ) {
          sticky.classList.remove('sticky-options-expanded');
        }
      });

      /*
       * Keep the displayed variant in sync with changes made
       * through the original product form or the theme's variant picker.
       */
      document.addEventListener('change', function (event) {
        var target = event.target;

        if (
          !target ||
          sticky.contains(target) ||
          !target.matches('select, input[type="radio"]')
        ) {
          return;
        }

        var variant = findSelectedVariant();

        if (variant) {
          updateVariantDisplay(variant);
        }
      });

      /*
       * Use the existing product form's Add to Cart button.
       */
      stickyButton.addEventListener('click', function () {
        var originalButtonId = stickyButton.dataset.buttonid;
        var originalButton = document.getElementById(originalButtonId);

        if (!originalButton) {
          console.error(
            'Original Add to Cart button not found:',
            originalButtonId
          );
          return;
        }

        var form = originalButton.closest('form');

        if (subscribeButton && form) {
          var existingPlanInput = form.querySelector(
            '[name="selling_plan"]'
          );

          if (subscribeButton.getAttribute('aria-checked') === 'true') {
            if (!selectedPlanId) {
              console.error('No selling plan is available.');
              return;
            }

            if (!existingPlanInput) {
              existingPlanInput = document.createElement('input');
              existingPlanInput.type = 'hidden';
              existingPlanInput.name = 'selling_plan';
              form.appendChild(existingPlanInput);
            }

            existingPlanInput.value = selectedPlanId;
          } else if (existingPlanInput) {
            existingPlanInput.value = '';
          }
        }

        originalButton.click();
      });

      /*
       * Show the subscription toggle only when Shopify provides
       * selling plans for this product.
       */
      if (subscribeButton) {
        subscribeButton.addEventListener('click', function () {
          var enabled =
            subscribeButton.getAttribute('aria-checked') === 'true';

          subscribeButton.setAttribute(
            'aria-checked',
            String(!enabled)
          );
        });
      }

      /*
       * Preserve the theme's existing scroll-triggered visibility.
       * The bar remains hidden until the product's main purchase
       * button has moved out of the visible area.
       */
      var anchor = document.getElementById('js-anchor-sticky-cart');
      var originalAddButton = document.getElementById(
        stickyButton.dataset.buttonid
      );

      function updateStickyVisibility() {
        if (!originalAddButton) return;

        var rect = originalAddButton.getBoundingClientRect();
        var shouldShow = rect.bottom < 0;

        sticky.classList.toggle('active', shouldShow);
      }

      if ('IntersectionObserver' in window && originalAddButton) {
        var purchaseObserver = new IntersectionObserver(
          function () {
            updateStickyVisibility();
          },
          { threshold: 0 }
        );

        purchaseObserver.observe(originalAddButton);
      }

      window.addEventListener('scroll', updateStickyVisibility, {
        passive: true
      });

      window.addEventListener('resize', updateStickyVisibility);

      updateStickyVisibility();

      var initialVariant = variants.find(function (variant) {
        return String(variant.id) === activeVariantId;
      });

      if (initialVariant) {
        updateVariantDisplay(initialVariant);
      }

      // Run once after all sticky-cart elements and listeners are ready.
      scheduleStickyPriceSync();
    })();
  </script>
{%- endif -%}
