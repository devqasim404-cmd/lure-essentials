{% comment %}}<div class="product_video">
  <div class="video-grid" data-video-set>
    {% for i in (1..10) %}
      {% assign video_key = 'video' | append: i %}
      {% assign label_key = 'label' | append: i %}
      {% assign thumb_key = 'thumbnail' | append: i %}

      {% assign video = block.settings[video_key] %}
      {% assign label = block.settings[label_key] %}
       {% assign thumbnail = block.settings[thumb_key] %} 

      {% if video != blank %}
        <div class="video-thumb_video">
          <div
            class="video-thumb"
            data-index="{{ forloop.index0 }}"
            data-group="{{ block.id }}"
            data-video-url="{{ video }}"
          >
            <video
              src="{{ video }}"
              muted
              loop
              playsinline
              preload="metadata"
              class="inline-video-preview"
              style="width:100%;height:auto;object-fit:cover;border-radius: 50%;aspect-ratio: 1 / 1;padding: 6px;"
            ></video>
            <div class="play-icon">
              <svg
                width="17"
                height="20"
                viewBox="0 0 17 20"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path d="M0.752558 0.241755L16.9494 9.97377L0.422782 19.1346L0.752558 0.241755Z" fill="white"></path>
              </svg>
            </div>
          </div>
          {% if label %}
            <div class="video-label">{{ label }}</div>
          {% endif %}
        </div>
      {% endif %}
    {% endfor %}
  </div>
{% endcomment %}

<div class="product_video">
  <div class="video-grid" data-video-set>
    {% for i in (1..10) %}
      {% assign video_key = 'video' | append: i %}
      {% assign label_key = 'label' | append: i %}
      {% assign thumb_key = 'thumbnail' | append: i %}

      {% assign video = block.settings[video_key] %}
      {% assign label = block.settings[label_key] %}
      
     {% assign thumbnail = block.settings[thumb_key] %} 
      {% if video != blank %}
        <div class="video-thumb_video">
          <div
            class="video-thumb"
            data-index="{{ forloop.index0 }}"
            data-group="{{ block.id }}"
            data-video-url="{{ video }}"
          >
           {% if i == 2 %}{% else %}<img src="{{ thumbnail | img_url: width: 300 }}" alt="Thumbnail">{%endif %}
            <video
              src="{{ video }}"
              muted
              loop
              playsinline
              preload="metadata"
              class="inline-video-preview"
              style="width:100%;height:auto;object-fit:cover; {% if i == 2 %}{% else %}display:none;{% endif %}"
            ></video>
            <div class="play-icon"><svg width="17" height="20" viewBox="0 0 17 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M0.752558 0.241755L16.9494 9.97377L0.422782 19.1346L0.752558 0.241755Z" fill="white"></path></svg>
</div>
          </div>
          {% if label %}
            <div class="video-label">{{ label }}</div>
          {% endif %}
        </div>
 
      {% endif %}
    {% endfor %}
  </div>
  <!-- Popup Overlay Added -->
  <div id="videoPopup" class="video-popup-overlay">
    <div class="video-popup-content">
      <span class="video-popup-close" onclick="closeVideoPopup()">&times;</span>
      <video
        id="popupVideo"
        src=""
        controls
        autoplay
        playsinline
        style="background: #000; width: 100%; max-height: 70vh; border-radius: 16px;"
      ></video>
      <div class="video-popup-nav">
        <button class="prevVideo" onclick="prevVideo()">&#8592; Prev</button>
        <button class="nextVideo" onclick="nextVideo()">Next &#8594;</button>
      </div>
    </div>
  </div>

  <script>
                      let currentVideoIndex = 0;
                      let currentGroup = '';
                      let allVideos = [];
                      
                      function openVideoPopup(group, index) {
                        currentGroup = group;
                        currentVideoIndex = index;
                      
                        allVideos = Array.from(document.querySelectorAll(`.video-thumb[data-group="${group}"]`));
                        const selected = allVideos[currentVideoIndex];
                        const videoURL = selected.getAttribute("data-video-url");
                      
                        const popupVideo = document.getElementById("popupVideo");
                        popupVideo.src = videoURL;
                        document.getElementById("videoPopup").classList.add("active");
                        popupVideo.pause(); // Ensure paused
                      
                        // Always show play icon initially
                        const playIcon = document.getElementById("popupPlayIcon");
                        if (playIcon) playIcon.style.display = '';
                      }
                      
                      function closeVideoPopup() {
                        document.getElementById("videoPopup").classList.remove("active");
                        const popupVideo = document.getElementById("popupVideo");
                        popupVideo.pause();
                        popupVideo.src = "";
                      }
                      
                      document.addEventListener("keydown", function(e) {
                        if (e.key === "Escape") closeVideoPopup();
                      });
                      
                      function nextVideo() {
                        currentVideoIndex = (currentVideoIndex + 1) % allVideos.length;
                        openVideoPopup(currentGroup, currentVideoIndex);
                      }
                      
                      function prevVideo() {
                        currentVideoIndex = (currentVideoIndex - 1 + allVideos.length) % allVideos.length;
                        openVideoPopup(currentGroup, currentVideoIndex);
                      }
                      
                      document.addEventListener("DOMContentLoaded", function () {
                        document.querySelectorAll(".video-thumb").forEach((el, i) => {
                          el.addEventListener("click", function () {
                            openVideoPopup(this.dataset.group, parseInt(this.dataset.index));
                          });
                      
                          const video = el.querySelector('video');
                          const playIcon = el.querySelector('.play-icon');
                          if (video && playIcon) {
                            playIcon.style.display = '';
                            video.pause(); // Ensure video is paused and play icon is shown
                      
                            video.addEventListener('play', function() {
                              playIcon.style.display = 'none';
                            });
                            video.addEventListener('pause', function() {
                              playIcon.style.display = '';
                            });
                            video.addEventListener('error', function() {
                              playIcon.style.display = '';
                            });
                          }
                        });
                      
                        // --- Popup Play/Pause Icon Handler ---
                        const popupVideo = document.getElementById("popupVideo");
                        const playIcon = document.getElementById("popupPlayIcon");
                        if (popupVideo && playIcon) {
                          playIcon.style.display = '';
                          popupVideo.addEventListener('play', function() {
                            playIcon.style.display = 'none';
                          });
                          popupVideo.addEventListener('pause', function() {
                            playIcon.style.display = '';
                          });
                          popupVideo.addEventListener('click', function() {
                            if (popupVideo.paused) {
                              popupVideo.play();
                            } else {
                              popupVideo.pause();
                            }
                          });
                          playIcon.addEventListener('click', function(e) {
                            popupVideo.play();
                            e.stopPropagation();
                          });
                        }
                      });
                         document.addEventListener("DOMContentLoaded", function () {
                        // Your existing code ...
                      
                        // --- Autoplay only the second video ---
                        var allThumbVideos = document.querySelectorAll('.inline-video-preview');
                        if (allThumbVideos.length > 1) {
                          // Pause all videos
                          allThumbVideos.forEach(v => v.pause());
                          // Play the second one
                          allThumbVideos[1].muted = true;
                          allThumbVideos[1].play();
                        }
                      });
  </script>
