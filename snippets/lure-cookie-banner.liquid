{%- comment -%}
  Compact restyle of Shopify's built-in cookie banner (Customer Privacy).
  Shopify renders the banner itself (#shopify-pc__banner); this only restyles it.
  Colours and options: Theme settings > Cookie banner.
  Wording: Shopify admin > Settings > Customer privacy > Cookie banner.
  - Desktop/tablet: small card at the bottom (right, left or centre).
  - Phones: slim card along the bottom, Accept + Decline side by side.
{%- endcomment -%}
{%- unless settings.lure_pc_enable == false -%}
<style>
  #shopify-pc__banner {
    --lpc-bg: {{ settings.lure_pc_bg | default: '#ffffff' }};
    --lpc-border: {{ settings.lure_pc_border | default: '#dce1ea' }};
    --lpc-title: {{ settings.lure_pc_title | default: '#141a5c' }};
    --lpc-text: {{ settings.lure_pc_text | default: '#4a5170' }};
    --lpc-link: {{ settings.lure_pc_link | default: '#1769c2' }};
    --lpc-accept-bg: {{ settings.lure_pc_accept_bg | default: '#141a5c' }};
    --lpc-accept-text: {{ settings.lure_pc_accept_text | default: '#ffffff' }};
    --lpc-decline: {{ settings.lure_pc_decline | default: '#141a5c' }};
    --lpc-manage: {{ settings.lure_pc_manage | default: '#6b7190' }};
    --lpc-radius: {{ settings.lure_pc_radius | default: 14 }}px;
  }
  #shopify-pc__banner.shopify-pc__banner__dialog {
    top: auto !important;
    {%- case settings.lure_pc_position -%}
      {%- when 'left' %}
    right: auto !important;
    left: 24px !important;
      {%- when 'center' %}
    right: 0 !important;
    left: 0 !important;
    margin: 0 auto !important;
      {%- else %}
    right: 24px !important;
    left: auto !important;
    {%- endcase %}
    bottom: 24px !important;
    width: 420px !important;
    max-width: calc(100vw - 24px) !important;
    {%- unless settings.lure_pc_position == 'center' %}
    margin: 0 !important;
    {%- endunless %}
    padding: 18px 20px !important;
    border: 1px solid var(--lpc-border) !important;
    border-radius: var(--lpc-radius) !important;
    background: var(--lpc-bg) !important;
    box-shadow: 0 12px 36px rgba(20, 26, 92, 0.18) !important;
    color: var(--lpc-text) !important;
    transform: none !important;
  }
  #shopify-pc__banner .shopify-pc__banner__wrapper {
    display: block !important;
    max-width: none !important;
    margin: 0 !important;
    padding: 0 !important;
  }
  #shopify-pc__banner .shopify-pc__banner__body {
    max-height: none !important;
    margin: 0 0 12px !important;
    padding: 0 !important;
    overflow: visible !important;
  }
  #shopify-pc__banner #shopify-pc__banner__body-title {
    margin: 0 0 4px !important;
    font-size: 15px !important;
    font-weight: 600 !important;
    line-height: 1.3 !important;
    color: var(--lpc-title) !important;
  }
  #shopify-pc__banner .shopify-pc__banner__body p {
    margin: 0 !important;
    font-size: 13px !important;
    line-height: 1.45 !important;
    color: var(--lpc-text) !important;
  }
  #shopify-pc__banner .shopify-pc__banner__body a { color: var(--lpc-link) !important; }

  /* Buttons: Accept + Decline side by side, Manage preferences as a small link */
  #shopify-pc__banner .shopify-pc__banner__btns {
    display: grid !important;
    grid-template-columns: 1fr 1fr !important;
    gap: 8px !important;
    width: auto !important;
    margin: 0 !important;
    padding: 0 !important;
  }
  #shopify-pc__banner .shopify-pc__banner__btns button {
    width: 100% !important;
    max-width: none !important;
    height: 40px !important;
    min-height: 40px !important;
    margin: 0 !important;
    padding: 0 12px !important;
    border-radius: 999px !important;
    font-size: 13.5px !important;
    font-weight: 600 !important;
  }
  #shopify-pc__banner #shopify-pc__banner__btn-accept {
    order: 1 !important;
    border: 1.5px solid var(--lpc-accept-bg) !important;
    background: var(--lpc-accept-bg) !important;
    color: var(--lpc-accept-text) !important;
  }
  #shopify-pc__banner #shopify-pc__banner__btn-decline {
    order: 2 !important;
    border: 1.5px solid var(--lpc-decline) !important;
    background: transparent !important;
    color: var(--lpc-decline) !important;
  }
  #shopify-pc__banner #shopify-pc__banner__btn-manage-prefs {
    order: 3 !important;
    grid-column: 1 / -1 !important;
    height: auto !important;
    min-height: 0 !important;
    padding: 2px 0 0 !important;
    border: 0 !important;
    background: none !important;
    color: var(--lpc-manage) !important;
    font-size: 12px !important;
    font-weight: 500 !important;
    text-decoration: underline !important;
  }
  #shopify-pc__banner .shopify-pc__banner__btns button:focus-visible {
    outline: 2px solid #2f8fe8 !important;
    outline-offset: 2px !important;
  }

  @media (max-width: 639px) {
    #shopify-pc__banner.shopify-pc__banner__dialog {
      right: 12px !important;
      bottom: 12px !important;
      left: 12px !important;
      width: auto !important;
      max-width: none !important;
      margin: 0 !important;
      padding: 14px 16px 12px !important;
    }
    {%- unless settings.lure_pc_hide_title_mobile == false %}
    #shopify-pc__banner #shopify-pc__banner__body-title { display: none !important; }
    {%- endunless %}
    #shopify-pc__banner .shopify-pc__banner__body { margin-bottom: 10px !important; }
    #shopify-pc__banner .shopify-pc__banner__body p { font-size: 12.5px !important; }
  }
</style>
{%- endunless -%}
